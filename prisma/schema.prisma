generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

// VOIDED: a void is treated as a real stock return (see PaymentMethod note
// below on business-rule docs) — the reversing invoice restores inventory
// automatically. It is never an edit to the original invoice (that would
// break the append-only guarantee everything else here relies on); instead
// it's a new Invoice row that references the one it reverses — see
// `voidsInvoiceId` below.
enum InvoiceStatus {
  COMPLETED
  PENDING_REVIEW
  VOIDED
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionRecordStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

enum PaymentMethod {
  CASH
  SHAM_CASH
  SYRIATEL_CASH
  BANK_TRANSFER
  OTHER
}

model Tenant {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  logo               String?
  phone              String?
  dailyExchangeRate  Decimal?                 @db.Decimal(18, 4)
  subscriptionStatus TenantSubscriptionStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users            User[]
  products         Product[]
  productUnits     ProductUnit[]
  productBatches   ProductBatch[]
  customers        Customer[]
  invoices         Invoice[]
  invoiceItems     InvoiceItem[]
  customerPayments CustomerPayment[]
  subscriptions    Subscription[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String?
  isPublic  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        ProductUnit[]
  batches      ProductBatch[]
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ProductUnit {
  id               String  @id @default(cuid())
  tenantId         String
  productId        String
  unitName         String
  conversionFactor Decimal @db.Decimal(18, 4)
  priceUSD         Decimal @db.Decimal(18, 4)
  barcode          String?

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches      ProductBatch[]
  invoiceItems InvoiceItem[]

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  unitId      String
  batchNumber String
  // Can legitimately go negative (concurrent offline oversell) and is also
  // the field a VOIDED invoice's negative-quantity items increment back up
  // on stock return. Do not add a non-negative constraint without
  // revisiting both of those flows first.
  quantity    Decimal   @db.Decimal(18, 4)
  expiryDate  DateTime?
  // ADDED: resolveFifoAllocation's tie-break (when two batches share the
  // same expiryDate, or both have none) previously fell back to comparing
  // `id` as a string, relying on cuid's embedded timestamp ordering — an
  // implementation detail of cuid, not a documented guarantee. This column
  // makes "oldest received batch goes first" an explicit, intentional sort
  // key instead of an accident of the ID format. See fifo.ts.
  createdAt   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         ProductUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([productId])
  @@index([unitId])
  @@index([expiryDate])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  shopName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments CustomerPayment[]

  @@index([tenantId])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  customerId       String
  // VALIDATION RULE (enforced in the API layer, not the schema):
  //   totalSYP      ≈ totalUSD * exchangeRateUsed
  //   debtAmountUSD ≈ totalUSD - paidAmountUSD
  // Reject the write if either check fails at insert time — do not
  // silently recompute and overwrite what the caller sent.
  totalUSD         Decimal       @db.Decimal(18, 4)
  totalSYP         Decimal       @db.Decimal(18, 4)
  exchangeRateUsed Decimal       @db.Decimal(18, 4)
  paidAmountUSD    Decimal       @db.Decimal(18, 4)
  debtAmountUSD    Decimal       @db.Decimal(18, 4)
  isPaid           Boolean       @default(false)
  status           InvoiceStatus @default(COMPLETED)
  isSynced         Boolean       @default(true)
  offlineId        String?       @unique
  syncedAt         DateTime?
  createdAt        DateTime      @default(now())

  // BUSINESS RULE: a void = a real physical stock return. The application
  // layer creating a VOIDED invoice MUST include InvoiceItems mirroring the
  // original ones with negated `quantity`, and MUST increment the matching
  // ProductBatch.quantity by that same (absolute) amount. A pure data-entry
  // mistake with no physical stock movement is corrected with an offsetting
  // CustomerPayment instead, not this mechanism.
  voidsInvoiceId String?  @unique
  voidsInvoice   Invoice? @relation("InvoiceVoid", fields: [voidsInvoiceId], references: [id], onDelete: Restrict)
  voidedBy       Invoice? @relation("InvoiceVoid")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  tenantId     String
  invoiceId    String
  productId    String
  unitId       String
  // REQUIRED: every line item records exactly which physical batch its
  // stock came from. If a sale spans more than one batch, split it into
  // multiple InvoiceItem rows on the SAME invoice — one per batch — never
  // a single row spanning batches.
  batchId      String
  quantity     Decimal @db.Decimal(18, 4)
  unitPriceUSD Decimal @db.Decimal(18, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    ProductUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([batchId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  amountUSD     Decimal       @db.Decimal(18, 4)
  amountSYP     Decimal       @db.Decimal(18, 4)
  exchangeRate  Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  receiptNo     String?
  notes         String?
  isSynced      Boolean       @default(true)
  offlineId     String?       @unique
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model Subscription {
  id              String                   @id @default(cuid())
  tenantId        String
  receiptImageURL String?
  amountUSD       Decimal                  @db.Decimal(18, 4)
  status          SubscriptionRecordStatus @default(PENDING_APPROVAL)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}
