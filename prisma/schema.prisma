generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// v3.4 TENANT ISOLATION NOTE (see lib/db/tenant-scope.ts, not represented in
// this file since Prisma has no schema-level construct for it):
//
// PHASE 1 (launch): a Prisma Client Extension wraps every generated model
// method and injects `tenantId` from the authenticated session automatically.
// The ONE raw query in this system (T4c's `SELECT ... FOR UPDATE` batch lock)
// is exempted from that extension's typed interception, so it goes through a
// dedicated wrapper instead:
//
//   async function tenantScopedRawQuery<T>(
//     tx: Prisma.TransactionClient,
//     tenantId: string,          // required at the TYPE level — a call site
//     sql: Prisma.Sql            // missing this argument fails to compile.
//   ): Promise<T> {
//     return tx.$queryRaw`${sql} AND tenant_id = ${tenantId}`;
//   }
//
// An ESLint rule blocks any direct `$queryRaw`/`$queryRawUnsafe` call outside
// that one file. CI fails the build on violation.
//
// [v3.4] NESTED WRITES — PROJECT-WIDE RULE, NOT JUST T4:
// The Client Extension intercepts direct model.method calls
// (prisma.invoice.create(...)) but does NOT intercept nested writes buried
// inside another model's `data` (e.g. `prisma.invoice.create({ data: {
// items: { create: [...] } } })`). A nested create/update/upsert/set/
// disconnect targeting a tenant-scoped model bypasses the extension's
// injection entirely — if tenantId is required-with-no-default on that
// model (as it is on InvoiceItem, ProductUnit, ProductBatch, etc.), this
// either throws, or — worse — silently succeeds if a caller supplied their
// own tenantId from an untrusted payload.
//
// This is NOT scoped to T4 specifically: any future write path (T5's B2B
// order intake, T6's subscription billing) is equally exposed the moment
// it uses a nested write on a tenant-scoped model. The rule therefore lives
// here, next to the raw-query rule, not in any single task's spec:
//   NO nested create/update/upsert/set/disconnect targeting a tenant-scoped
//   model, anywhere in the codebase. Every write to a tenant-scoped model
//   is its own top-level prisma.model.<method>(...) call, issued inside the
//   same $transaction as any related writes it must stay atomic with.
// Enforced the same way as the raw-query rule: an ESLint rule flags nested
// `create`/`update`/`upsert`/`set`/`disconnect` keys inside another tenant-
// scoped model's `data`/`include` object, and CI fails the build on
// violation. T4c's existing design (Invoice + InvoiceItem written as
// separate top-level calls inside one $transaction) already follows this
// rule — it should be the template every later task copies, not a T4-only
// pattern. [v3.7] B2BOrderRequest's approval flow (below) follows the exact
// same template: approving an order writes Invoice + InvoiceItem(s) +
// (if applicable) a new Customer, each as its own top-level call inside one
// $transaction, then a final top-level update on B2BOrderRequest itself
// setting resultingInvoiceId/status — never a nested write chained off any
// of those creates.
//
// PHASE 2 (hardening, before scaling past the pilot merchant set): real
// Postgres RLS. Requires, per tenant-scoped table below:
//   ALTER TABLE "<Table>" ENABLE ROW LEVEL SECURITY;
//   ALTER TABLE "<Table>" FORCE ROW LEVEL SECURITY;  -- ENABLE alone exempts
//                                                     -- the table owner.
//   CREATE POLICY tenant_isolation ON "<Table>"
//     USING (tenant_id = current_setting('app.tenant_id')::text);
// PLUS: the application's DB connection must use a role that is NOT the
// table owner (the migration role typically is the owner, and owners bypass
// RLS regardless of FORCE). PLUS: every DB call — reads included — must run
// inside a `tenantTransaction(tenantId, cb)` wrapper that issues
// `SET LOCAL app.tenant_id = $1` first (safe with pgbouncer transaction-mode
// pooling; SET LOCAL is scoped to transaction lifetime, no cross-transaction
// leak). These policies are hand-written raw SQL migrations, NOT expressible
// in this schema.prisma file — `prisma db push` will silently skip them, so
// an automated cross-tenant integration test suite (T7) is the compensating
// control, not code review alone. [v3.4] That T7 suite must cover nested-
// write bypass attempts specifically, not just direct-query isolation.
// [v3.7] B2BOrderRequest and B2BOrderRequestItem are tenant-scoped models
// like any other and must be included in that T7 suite and in the Phase 2
// RLS rollout — they carry no special exemption.
// ============================================================================

// ============================================================================
// [v3.6] CURRENCY RE-ANCHORING NOTE — reverses the v3.0 USD-anchor decision.
//
// Through v3.5, USD was the authoritative currency for every financial
// record (Invoice.totalUSD/paidAmountUSD/debtAmountUSD, CustomerPayment.
// amountUSD) — SYP was tracked alongside purely as a courtesy display
// conversion, frozen per-transaction via exchangeRateUsed/exchangeRate. The
// stated reason was inflation-hedging: a USD-denominated debt holds its
// value regardless of what happens to the Lira between the sale and
// repayment.
//
// As of v3.6, that's reversed: SYP is now the authoritative currency for
// every financial record below. USD is retained on every model purely as a
// derived, informational figure (still computed via the same frozen
// exchangeRateUsed/exchangeRate, just no longer load-bearing). This is a
// deliberate trade-off, not an oversight — a SYP-denominated debt can lose
// real value to inflation between sale and repayment, same risk the v3.0
// design existed to avoid. It was made because this platform serves one
// market (Syria) whose merchants think, price, and settle in Lira day to
// day, and forcing USD-primary bookkeeping fought that reality rather than
// serving it.
//
// Concretely, this means:
//   - Invoice.totalSYP / paidAmountSYP / debtAmountSYP are the fields every
//     validation, ledger balance, and business rule reads and writes
//     first. totalUSD / paidAmountUSD / debtAmountUSD are derived
//     (SYP ÷ exchangeRateUsed) and shown for merchant reference only —
//     never validated against, never gate any action.
//   - CustomerPayment.amountSYP is authoritative; amountUSD is derived the
//     same way via exchangeRate.
//   - InvoiceItem.unitPriceSYP is authoritative; unitPriceUSD is derived.
//   - Subscription.amountUSD is UNCHANGED and intentionally stays USD —
//     that's the platform's own SaaS revenue from the merchant, a separate
//     business decision from how a merchant tracks their own customers'
//     debt.
//   - No `settlementCurrency`-style per-tenant configurability was
//     introduced (that flexible approach was considered and rejected back
//     in v3.4 for unrelated reasons). This re-anchoring is uniform and
//     unconditional across every tenant, since the platform targets one
//     market rather than needing per-tenant currency choice.
// ============================================================================

// ============================================================================
// [v3.7] FOUR GAPS CLOSED IN THIS REVISION (see accompanying notes at each
// model below for the full reasoning):
//   1. B2BOrderRequest / B2BOrderRequestItem — a B2B storefront submission
//      (T5) has no User session and no committed stock allocation yet, so it
//      cannot be represented as an Invoice/InvoiceItem row (both fields are
//      required-non-null there). A dedicated pre-invoice holding model closes
//      this without weakening Invoice's existing guarantees.
//   2. CustomerMergeLog — T4e requires the customer-merge action to be
//      logged for audit purposes; no model previously captured that.
//   3. Subscription.tier / Subscription.referenceCode — T6 requires tier
//      selection and a unique payment reference code; neither field existed.
//   4. ProductUnit.isActive — T3 needs a way to retire a single packaging
//      unit without hard-deleting it (which would collide with the
//      ProductBatch Restrict/Cascade interaction, the same class of problem
//      already documented for Tenant/Customer above).
// ============================================================================

enum UserRole {
  ADMIN
  CASHIER
}

// A void/refund is never an edit to the original invoice (that would break
// the append-only guarantee everything else here relies on). Instead it's
// a new Invoice row that references the one it reverses — see
// `voidsInvoiceId` below. VOIDED marks that new row itself.
enum InvoiceStatus {
  COMPLETED
  PENDING_REVIEW
  VOIDED
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionRecordStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

// The platform SOW names Sham Cash, Syriatel Cash, and Office Transfer as
// the three real payment rails merchants use — all three must be
// distinguishable in reporting, never collapsed into a free-text field or
// silently bucketed under OTHER.
enum PaymentMethod {
  CASH
  SHAM_CASH
  SYRIATEL_CASH
  BANK_TRANSFER
  OTHER
}

// v3.1 ADDITION (amendment #1+#2 — sticky manual pricing).
// A ProductUnit's real price is a number the merchant sets by hand, in
// whichever currency they think in for that specific item — never derived
// automatically from Tenant.dailyExchangeRate. Two different products can
// sit in two different currencies at the same time (e.g. rice priced in
// SYP, sugar priced in USD) with zero coupling between them. Changing the
// exchange rate in T2's top bar must NEVER move this number; the top bar
// rate is only used (a) for display of the *other* currency as a courtesy
// conversion, and (b) frozen per-sale into Invoice.exchangeRateUsed so the
// debt ledger keeps working exactly as originally designed.
//
// [v3.6] Note this enum's default was already SYP before the currency
// re-anchoring above — most products already flowed through this pipeline
// correctly. The re-anchoring mainly changes how a USD-priced unit's sale
// gets recorded (converted INTO SYP for the authoritative fields), the
// reverse of the old direction.
enum PricingCurrency {
  USD
  SYP
}

// v3.1 ADDITION (amendment #6 — real GS1 barcodes vs internally generated
// ones). Syria is registered with GS1 under prefix 621, so any barcode
// starting with it is a real, shareable identifier. A product with no
// printed barcode gets one generated in the 20–29 prefix range, which GS1
// reserves specifically for internal/restricted use — that generated code
// must never be pushed into the shared ProductCatalogEntry table, since
// two unrelated tenants' internally generated codes can collide.
enum BarcodeSource {
  GS1
  INTERNAL
}

// v3.1 ADDITION (amendment #5 — shared catalog correction flow).
// A report against a ProductCatalogEntry never edits it directly (see the
// ownership note on ProductCatalogEntry below) — it queues a suggested
// correction for a human (platform super-admin) to apply or dismiss.
enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// [v3.7] ADDITION — see the B2BOrderRequest note below for the full
// reasoning. Deliberately mirrors InvoiceStatus's PENDING_REVIEW naming for
// conceptual continuity, but is its own enum: a B2BOrderRequest never
// reaches COMPLETED or VOIDED itself — once APPROVED it hands off to a real
// Invoice row, which then carries its own independent lifecycle.
enum B2BOrderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// [v3.5] LIFECYCLE NOTE: Tenant rows are never hard-deleted anywhere in this
// system — subscriptionStatus (ACTIVE | EXPIRED | PENDING) plus expiresAt is
// the sole lockout mechanism (T2/T6), and no API route, admin action, or
// scheduled job in this spec issues a real DELETE against a Tenant row. This
// matters specifically because of the Cascade/Restrict interaction below:
// Customer.tenant cascades (deleting a Tenant would delete all its Customers,
// including its own system-generated one), while Tenant.systemCustomer is
// Restrict (a Customer wired up as a system customer can't be deleted while
// referenced). If a real hard-delete path is ever introduced, revisit
// Customer.tenant's onDelete — Cascade may attempt to delete the very
// Customer row Restrict is protecting, in the same operation, which is at
// minimum undefined-feeling behavior worth testing explicitly before relying
// on it.
model Tenant {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  logo               String?
  phone              String?
  dailyExchangeRate  Decimal?                 @db.Decimal(18, 4)
  subscriptionStatus TenantSubscriptionStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users             User[]
  products          Product[]
  productUnits      ProductUnit[]
  productBatches    ProductBatch[]
  customers         Customer[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  customerPayments  CustomerPayment[]
  subscriptions     Subscription[]
  // [v3.7] ADDITION — see B2BOrderRequest / CustomerMergeLog notes below.
  b2bOrderRequests  B2BOrderRequest[]
  customerMergeLogs CustomerMergeLog[]

  // [v3.3, corrected] The tenant's single "Walk-in Cash Customer," seeded
  // at onboarding (T2). A plain 1:1 relation via a nullable scalar FK is
  // what actually enforces "at most one system customer per tenant" — a
  // single field can only ever hold one value, so the invariant is
  // structural, not a constraint that can be misapplied. An earlier draft
  // considered `@@unique([tenantId, isSystemGenerated])` on Customer
  // instead; that was wrong (isSystemGenerated is a two-valued boolean,
  // so it would have also capped every tenant at exactly ONE real
  // customer with isSystemGenerated = false, breaking the model for
  // every wholesaler who needs many real customers). This relation
  // replaces that idea entirely — Customer.isSystemGenerated remains only
  // as a fast filter flag, carrying no uniqueness enforcement itself.
  // @unique here additionally prevents the same Customer row from ever
  // being wired up as the system customer for more than one Tenant.
  systemCustomerId     String?               @unique
  systemCustomer       Customer?             @relation("TenantSystemCustomer", fields: [systemCustomerId], references: [id], onDelete: Restrict)
  b2bOrderRequestItems B2BOrderRequestItem[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  isPlatformAdmin Boolean  @default(false)
  // Soft-delete flag. A departing cashier/admin gets deactivated, never
  // hard-deleted — see the Restrict note on Invoice.user below for why a
  // real DELETE on this row must never be allowed to succeed anyway.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  // [v3.7] ADDITION — the admin who approved/rejected a B2B order request,
  // and the admin who performed a customer merge. Restrict, same reasoning
  // as Invoice.user: deactivating a User must never silently erase which
  // admin took a given action.
  reviewedB2BOrderRequests B2BOrderRequest[]
  customerMergeLogs        CustomerMergeLog[]

  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String?
  isPublic  Boolean  @default(false)
  // Soft-delete flag, same reasoning as User.isActive — a discontinued
  // product's historical InvoiceItems must stay intact.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units                ProductUnit[]
  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  // [v3.7] ADDITION — see B2BOrderRequestItem below. Restrict on that side,
  // so this array is purely informational/navigational here.
  b2bOrderRequestItems B2BOrderRequestItem[]

  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ProductUnit {
  id        String @id @default(cuid())
  // Denormalized from Product so this table is directly reachable by
  // tenantId — needed both for RLS to apply to it directly (see the v3.4
  // Tenant Isolation note at the top of this file for what actually
  // enforces that today vs. what's planned) and to scope barcode
  // uniqueness per tenant below.
  tenantId  String
  productId String
  unitName  String

  conversionFactor Decimal @db.Decimal(18, 4)

  // --- v3.1 PRICING MODEL (amendments #1 + #2) -----------------------
  // `priceUSD` (v3.0) is REMOVED. It forced every product's price to move
  // automatically with Tenant.dailyExchangeRate, which does not match how
  // merchants actually set prices in this market (a manual decision per
  // item, not a live peg). Replaced with:
  pricingCurrency PricingCurrency @default(SYP)
  // The real, wholesale, charged price — in `pricingCurrency`. This is the
  // ONLY number ever used to compute a sale, on POS (T4b) and on the B2B
  // storefront (T5) alike. Changed only by explicit merchant action on
  // this exact ProductUnit; never recalculated in bulk when the daily
  // exchange rate changes.
  priceWholesale  Decimal         @db.Decimal(18, 4)
  // A suggested retail price, shown ALONGSIDE priceWholesale as a
  // marketing/profit-margin hint for the buying retailer — it is never
  // charged and never written to any Invoice/InvoiceItem. Nullable
  // because plenty of wholesale-only merchants never set one; nullable
  // independently per ProductUnit, not per tenant, because a single
  // merchant can sell some items pure-wholesale and others retail-and-
  // wholesale at the same time.
  priceRetail     Decimal?        @db.Decimal(18, 4)
  // ---------------------------------------------------------------------

  // [v3.7] ADDITION (gap #4). Soft-delete flag, same reasoning as
  // Product.isActive above, added at the ProductUnit level specifically
  // because a single packaging variant (e.g. "كرتونة" for one product)
  // can need retiring independently of its parent Product or its sibling
  // units (e.g. "قطعة" for the same product staying on sale). A hard
  // DELETE here was never viable: ProductBatch.unit is onDelete: Cascade
  // from ProductUnit, but ProductBatch rows with sales history are
  // protected from deletion by InvoiceItem.batch's onDelete: Restrict —
  // the exact same Cascade/Restrict collision already documented for
  // Tenant/Customer above, just one level deeper in the graph. Deactivate
  // instead; a deactivated unit is simply hidden from POS/storefront
  // "add" pickers going forward while every historical InvoiceItem/
  // ProductBatch referencing it stays fully intact.
  isActive Boolean @default(true)

  // Storefront product photo. Nullable at the DB level (an internal,
  // POS-only product never needs one) but enforced as REQUIRED at the
  // application layer before `Product.isPublic` may be set true — same
  // enforcement pattern as priceRetail's optionality, just the opposite
  // requirement direction. See ProductCatalogEntry below for where a
  // suggested photo can come from at creation time.
  imageUrl String?

  barcode       String?
  // v3.1 ADDITION (amendment #6). Deliberately nullable with NO default —
  // a silent default of GS1 would make an unreviewed barcode eligible for
  // the shared catalog by accident. This must be set explicitly by the
  // merchant answering "printed by the factory, or a number you typed
  // in?" at the moment of entry, never guessed from the digit pattern.
  barcodeSource BarcodeSource?

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  // [v3.7] ADDITION — see B2BOrderRequestItem below.
  b2bOrderRequestItems B2BOrderRequestItem[]

  // Barcodes are a global standard — two different tenants can legitimately
  // sell the same imported item under the same barcode. Uniqueness is
  // scoped per tenant, not platform-wide. Postgres treats NULL as distinct
  // from every other NULL in a unique constraint, so this does not block
  // multiple products from having no barcode at all.
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
  // [v3.7] ADDITION — supports the POS/storefront "active units only" list
  // query without a full per-product scan.
  @@index([tenantId, isActive])
}

model ProductBatch {
  id          String    @id @default(cuid())
  // Same reasoning as ProductUnit.tenantId above.
  tenantId    String
  productId   String
  unitId      String
  batchNumber String
  // Can legitimately go negative: if two cashiers sell the last unit of a
  // batch while both offline, we let the sale through and flag it for the
  // merchant to reconcile on sync, rather than blocking a sale a paper
  // ledger would never have blocked either. Do not add a non-negative
  // constraint or a @default(0) validation on this field without revisiting
  // that decision first.
  //
  // [v3.3] Deliberately still no stored `isNegative`/`needsReconciliation`
  // flag — same "derive, don't store" preference used for Customer debt
  // below. T3's inventory UI queries `WHERE quantity < 0` directly to
  // render the "يحتاج تسوية" badge/filter tab; a stored flag would risk
  // drifting from the true quantity if a later batch write forgot to
  // update it.
  quantity    Decimal   @db.Decimal(18, 4)
  expiryDate  DateTime?
  // resolveFifoAllocation's tie-break (when two batches share the same
  // expiryDate, or both have none) sorts on this column explicitly,
  // instead of falling back to comparing `id` as a string — an
  // implementation detail of cuid's embedded timestamp, not a documented
  // ordering guarantee. fifo.ts (T3) depends on this column directly.
  //
  // [v3.3] LOCK ORDERING: every code path that takes `SELECT ... FOR
  // UPDATE` locks across more than one ProductBatch row (T4c, at sync)
  // MUST acquire those locks `ORDER BY id ASC` — a fixed, stable order
  // applied identically regardless of which invoice or line item triggered
  // the lock. Without this, two concurrent sync transactions locking the
  // same two batches in opposite order can deadlock; Postgres aborts one
  // of them with an error rather than resolving it gracefully. This is
  // enforced in `lib/inventory/fifo.ts`, not at the schema level.
  //
  // [v3.7] Same lock-ordering rule applies when a B2B order approval
  // (B2BOrderRequest → Invoice) resolves FIFO allocation across batches —
  // it uses the exact same `resolveFifoAllocation` function and the exact
  // same lock-acquisition path as T4c, not a parallel implementation.
  createdAt   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         ProductUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([productId])
  @@index([unitId])
  @@index([expiryDate])
  // [v3.3] Supports T3's "يحتاج تسوية" filter tab querying negative-quantity
  // batches per tenant without a full table scan.
  @@index([tenantId, quantity])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  shopName  String?
  // Soft-delete flag — a customer with any invoice/payment history must
  // never be hard-deletable (see Restrict notes below).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // [v3.3] ADDITION. Exactly one row per tenant is seeded at onboarding
  // (T2) as the "Walk-in Cash Customer" — a placeholder for fully-paid,
  // identity-irrelevant cash sales, so the cashier isn't forced to collect
  // a name/phone for a simple cash transaction. APPLICATION-LEVEL RULE
  // (not a DB constraint): an Invoice may reference a customer with
  // isSystemGenerated = true ONLY when that invoice's debtAmountSYP = 0.
  // [v3.6] Was debtAmountUSD = 0 through v3.5 — see the currency
  // re-anchoring note at the top of this file. Any invoice carrying a
  // nonzero debt — full or partial — MUST reference a real Customer row
  // with name + phone, because the whole point of recording a customer
  // here is knowing who owes the money back.
  //
  // "At most one per tenant" is NOT enforced by this field or any index on
  // it — a composite index/unique on (tenantId, isSystemGenerated) would be
  // wrong here, since isSystemGenerated only has two values and that would
  // also cap every tenant at exactly one real (isSystemGenerated = false)
  // customer, breaking the model for every wholesaler with more than one
  // customer. The actual "exactly one" guarantee lives on Tenant's side —
  // see `Tenant.systemCustomerId`, a single nullable scalar field that by
  // construction can only ever point at one Customer row. This field
  // remains purely a fast filter flag (e.g. excluding the system customer
  // from T4e's ledger customer list without a join to Tenant).
  isSystemGenerated      Boolean @default(false)
  // Reverse side of Tenant.systemCustomerId — lets a Customer row know
  // it's wired up as its tenant's system customer, if it is.
  tenantAsSystemCustomer Tenant? @relation("TenantSystemCustomer")

  // T4 walk-in customer sync: mirrors the offlineId pattern already used
  // on Invoice and CustomerPayment. A walk-in customer created on the POS
  // while offline is assigned a client-generated UUID at creation time
  // (Dexie's offlineCustomers.offlineId) — /api/sync MUST look up an
  // existing Customer by this value BEFORE creating a new row, across
  // separate sync requests over time, not just within one request's
  // in-memory map. This @unique constraint is the last line of defense
  // against a duplicate.
  //
  // [v3.4] NOTE — deliberately NOT paired with a strict @@unique on phone
  // (see below): a hard unique on (tenantId, phone) would break the
  // legitimate case of one family shop legitimately registering several
  // Customer rows under the same phone number. The chosen mitigation for
  // accidental duplicate-customer debt-splitting is a soft duplicate
  // check in the customer-creation UI (both online and, critically,
  // against Dexie's cachedCustomers offline — this is a T4b/T4e concern,
  // not a schema one) plus an admin merge path in T4e if a duplicate slips
  // through anyway. Left undocumented at the schema level on purpose: it's
  // a product/application-layer decision, not a constraint this table can
  // express.
  offlineId String? @unique

  // Deliberately no stored balance column here — net debt is always
  // computed on-the-fly, never cached, to avoid a stored balance drifting
  // from the transaction history.
  // [v3.6] SUM(Invoice.debtAmountSYP) - SUM(CustomerPayment.amountSYP WHERE
  // invoiceId IS NULL) — was the USD equivalent of this formula through
  // v3.5; see the currency re-anchoring note at the top of this file.

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments CustomerPayment[]

  // [v3.7] ADDITION — see CustomerMergeLog and B2BOrderRequest below.
  // Two distinctly-named relations to CustomerMergeLog are required
  // because this model can appear on either side of a merge (as the
  // surviving row or as the one merged away) within the same log table.
  mergesAsSurvivor          CustomerMergeLog[] @relation("MergeSurviving")
  mergesAsMerged            CustomerMergeLog[] @relation("MergeMerged")
  matchedByB2BOrderRequests B2BOrderRequest[]

  @@index([tenantId])
  @@index([offlineId])
  // v3.1 ADDITION: supports both the abuse-prevention lookup ("how many
  // PENDING_REVIEW orders already exist for this phone across my
  // customers?") and cross-checking against VerifiedRetailer.phone below.
  // Deliberately NOT @@unique([tenantId, phone]) — see the note on
  // offlineId above for why a hard unique here is the wrong tool.
  //
  // [v3.5] Composite, not a lone `phone` index — the stated use case
  // ("how many PENDING_REVIEW orders already exist for this phone across
  // my customers?") is inherently per-tenant, so (tenantId, phone) serves
  // it directly instead of relying on Postgres filtering a residual
  // tenantId condition after a phone-only index scan.
  @@index([tenantId, phone])
  // [v3.3] Supports onboarding/lookup of a tenant's system-generated
  // customer without a full scan.
  @@index([tenantId, isSystemGenerated])
}

// v3.1 ADDITION (amendment #4 — B2B storefront trust, final decision).
// Deliberately NOT an OTP/SMS/missed-call verification. Real-time phone
// verification for Syrian numbers runs into the same sanctions-related
// routing uncertainty as WhatsApp Business API did — an external
// dependency this platform should not be built around in its first phase,
// especially for a problem (a wasted PENDING_REVIEW review) that a human
// wholesaler already absorbs cheaply via T5's existing manual approval
// step.
//
// [v3.3] Reminder: the per-IP/per-phone rate limits gating order
// submission (T5) are a deterrent layer, not a substitute for this manual
// approval step — they reduce noise reaching this trust mechanism, they
// don't replace it.
//
// Trust here is platform-wide and behavioral, not per-tenant and
// declarative: once ANY wholesaler on the platform approves a first order
// from a given phone number, that number is "known good" for every OTHER
// wholesaler too — a retailer should not have to rebuild trust from zero
// with every new supplier. Deliberately holds no relation to any specific
// Tenant or Customer row (a retailer's phone is not owned by any one
// wholesaler), and deliberately exposes nothing about WHICH wholesaler(s)
// verified it or what was ordered — just a yes/no signal — so competing
// wholesalers never leak business relationships to each other through
// this table.
model VerifiedRetailer {
  id                String   @id @default(cuid())
  phone             String   @unique
  shopName          String?
  firstVerifiedAt   DateTime @default(now())
  // Incremented (not just re-set) every time a different wholesaler
  // approves a first order from this phone — a light signal of how
  // widely trusted the number is, for potential future use (e.g.
  // surfacing "verified by N wholesalers" instead of a flat badge).
  verificationCount Int      @default(1)

  @@index([phone])
}

// v3.1 ADDITION (amendments #5 + #6 — shared product catalog).
// A lightweight, cross-tenant lookup table that lets a merchant scanning a
// barcode nobody at THIS tenant has entered yet still get a suggested
// name/category/photo if some OTHER tenant already entered the same real
// (GS1) product. This is a one-time fill-in-the-form convenience only —
// it is NEVER read again after creation time, and never silently pulls a
// tenant's own already-saved Product/ProductUnit data into sync with it.
// Editing a tenant's local copy after the fact never touches this table,
// and this table being edited/deleted later never touches any tenant's
// already-created local copy either. Only GS1-sourced barcodes should
// ever be written here (enforced at the application layer using
// ProductUnit.barcodeSource, not by a DB constraint — see BarcodeSource).
model ProductCatalogEntry {
  id       String  @id @default(cuid())
  barcode  String  @unique
  name     String
  category String?
  // Optional by design (amendment discussion): a merchant is never
  // blocked from creating a shared catalog entry just because they didn't
  // take a photo. A missing photo here simply means the next tenant who
  // scans this barcode gets no suggested photo and takes their own — see
  // ProductUnit.imageUrl for the SEPARATE, unrelated rule that a photo
  // IS required before THAT tenant's own product can go public.
  imageUrl String?

  // Simple ownership model: whichever tenant's scan created this row is
  // its "owner" and the only one who may edit it directly going forward.
  // Any other tenant that finds it wrong instead files a
  // ProductCatalogEntryReport (below) for a human to review — this avoids
  // both an edit war between unrelated merchants and the need for any
  // voting/permission system. Deliberately a plain String, not a Prisma
  // relation to Tenant: this row must survive untouched even if the
  // owning tenant is later deleted, and must never be blocked from
  // deletion by a Restrict/Cascade tie to a tenant's lifecycle.
  addedByTenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports ProductCatalogEntryReport[]

  @@index([barcode])
  @@index([addedByTenantId])
}

// v3.1 ADDITION. A suggested correction against a ProductCatalogEntry,
// filed by a tenant who is NOT its owner. Reviewed and applied (or
// dismissed) manually by the platform super-admin — same "no automated
// content moderation in phase one" decision as everywhere else this SOW
// takes that stance. Resolving or dismissing a report never touches any
// tenant's own local Product/ProductUnit copy (see the isolation note on
// ProductCatalogEntry above).
model ProductCatalogEntryReport {
  id                 String       @id @default(cuid())
  catalogEntryId     String
  reportedByTenantId String
  reason             String
  suggestedName      String?
  suggestedCategory  String?
  suggestedImageUrl  String?
  status             ReportStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  resolvedAt         DateTime?

  catalogEntry ProductCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([catalogEntryId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  customerId       String
  // [v3.6] AUTHORITATIVE as of this revision — see the currency
  // re-anchoring note at the top of this file. Every validation, the
  // ledger balance, and every business rule below reads/writes this field
  // first.
  totalSYP         Decimal       @db.Decimal(18, 4)
  // [v3.6] Informational only from this revision forward — derived as
  // totalSYP ÷ exchangeRateUsed at write time. Kept for merchant reference
  // and historical continuity; never validated against, never gates any
  // action. Was the authoritative field through v3.5.
  totalUSD         Decimal       @db.Decimal(18, 4)
  exchangeRateUsed Decimal       @db.Decimal(18, 4)
  // [v3.6] AUTHORITATIVE. New in this revision.
  paidAmountSYP    Decimal       @db.Decimal(18, 4)
  // [v3.6] Informational only — derived (paidAmountSYP ÷ exchangeRateUsed).
  paidAmountUSD    Decimal       @db.Decimal(18, 4)
  // [v3.6] AUTHORITATIVE. New in this revision.
  debtAmountSYP    Decimal       @db.Decimal(18, 4)
  // [v3.6] Informational only — derived (debtAmountSYP ÷ exchangeRateUsed).
  debtAmountUSD    Decimal       @db.Decimal(18, 4)
  isPaid           Boolean       @default(false)
  status           InvoiceStatus @default(COMPLETED)
  isSynced         Boolean       @default(true)
  offlineId        String?       @unique
  syncedAt         DateTime?
  receiptPdfUrl    String?
  createdAt        DateTime      @default(now())
  // No updatedAt: invoices are append-only. Corrections happen via a new
  // void/refund invoice (below) or a new CustomerPayment, never by editing
  // a past invoice in place.
  //
  // Unaffected by the v3.1 pricing change: whatever currency/price a
  // ProductUnit is set in, the SALE ITSELF still resolves to a single
  // exchangeRateUsed per invoice, and InvoiceItem.unitPriceSYP is still
  // always stored in SYP (converted at sync time from priceWholesale in
  // whichever pricingCurrency it was set in — [v3.6] was unitPriceUSD/USD
  // through v3.5, see the currency re-anchoring note at the top of this
  // file). [v3.6] `debtAmountSYP ≈ totalSYP − paidAmountSYP` is the
  // authoritative validation at sync (T4c); the USD-side equivalent
  // (`totalUSD ≈ totalSYP ÷ exchangeRateUsed`) is checked only as a
  // sanity/display consistency signal and never fails a sync on its own.
  // Through v3.5 this was the reverse: `totalSYP ≈ totalUSD ×
  // exchangeRateUsed` was the authoritative check.
  //
  // [v3.3] customerId may point at a tenant's isSystemGenerated customer
  // ONLY when debtAmountSYP = 0 for this row ([v3.6] was debtAmountUSD = 0
  // through v3.5) — enforced at the API layer when an invoice is
  // created/synced, not by a DB constraint (a DB-level CHECK spanning two
  // tables isn't practical here). Every other invoice must reference a
  // real, identified Customer.
  //
  // DELIBERATELY NO `paymentMethod` COLUMN HERE (T4 decision): the method
  // used for the amount paid at sale time (paidAmountSYP) is NOT stored on
  // Invoice directly. Instead, /api/sync inserts a matching CustomerPayment
  // row.
  //
  // [v3.7] A B2B order approval (T5) writes this row through the EXACT
  // SAME path as a POS sale or an /api/sync invoice — userId is the
  // approving ADMIN (not any account belonging to the retailer, who never
  // has one), and every InvoiceItem's batchId is resolved via
  // resolveFifoAllocation at approval time, not at order-submission time.
  // See the B2BOrderRequest model below for why the order itself cannot be
  // represented as an Invoice row until that approval happens.

  // A void/refund is its own Invoice row with status VOIDED, whose amounts
  // reverse the original. This field is set ONLY on that reversing row,
  // and points back at the invoice it voids. The original invoice is
  // never edited or flagged itself — its debt contribution is simply
  // offset once the reversing row's amounts are included in the SUM()
  // that computes customer debt. @unique here also means, at the DB
  // level, an invoice can be voided at most once.
  voidsInvoiceId String?  @unique
  voidsInvoice   Invoice? @relation("InvoiceVoid", fields: [voidsInvoiceId], references: [id], onDelete: Restrict)
  voidedBy       Invoice? @relation("InvoiceVoid")

  // Free-text reason captured at the moment of voiding (T4 Scope 4:
  // "Requires a reason (free text, audit trail) at the time of voiding").
  // Populated only on a VOIDED-status row; always null on a normal sale.
  voidReason String?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a cashier/admin must never silently
  // delete every invoice they ever created. Deactivate the user
  // (User.isActive = false) instead.
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: same reasoning — a customer's debt and purchase
  // history is exactly the record this platform exists to preserve.
  // Deactivate (Customer.isActive = false) instead of deleting.
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  // The sale-time payment CustomerPayment.invoiceId (below) points back
  // at, if paidAmountSYP > 0 on this invoice. Nullable/optional because a
  // fully-on-credit invoice (paidAmountSYP = 0) has none.
  payment CustomerPayment?

  // [v3.7] ADDITION — reverse side of B2BOrderRequest.resultingInvoiceId.
  // Optional/nullable because the overwhelming majority of invoices come
  // from the POS (T4b), not a B2B approval — this is populated only on
  // the invoice a B2B order approval produced.
  b2bOrderRequest B2BOrderRequest?

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
  // [v3.4] ADDITION. Serves two real, already-planned read paths, not a
  // hypothetical one: (a) the dashboard's "invoices this period" KPI
  // queries (T1 folder structure's dashboard/page.tsx), which without
  // this would fall back to a per-tenant scan sorted after the fact; and
  // (b) T4c's own sync-conflict resolution, which orders a tenant's
  // invoices by createdAt. Cheap to add now, expensive to retrofit once
  // the table has real transaction volume.
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  // Same reasoning as ProductUnit.tenantId above.
  tenantId     String
  invoiceId    String
  productId    String
  unitId       String
  // Every line item must record exactly which physical batch its stock
  // came from. This is what makes FIFO deduction traceable, what a VOIDED
  // invoice's reversal writes stock back to, and it's the column
  // resolveFifoAllocation's result (T3/T4) is written into.
  //
  // BUSINESS RULE: if a sold quantity spans more than one batch (the
  // nearest batch doesn't have enough left), split it into multiple
  // InvoiceItem rows on the SAME invoice — one per batch — never a single
  // row spanning batches.
  //
  // [v3.3] When a single sale's allocation spans multiple ProductBatch
  // rows, the locks acquired on those rows at sync time (T4c) follow the
  // fixed `ORDER BY id ASC` rule documented on ProductBatch above.
  //
  // [v3.4] Written as its own top-level prisma.invoiceItem.create(...)
  // call inside the same $transaction as the parent Invoice — never as a
  // nested `items: { create: [...] }` under Invoice.create(...). See the
  // NESTED WRITES note at the top of this file for why.
  batchId      String
  quantity     Decimal @db.Decimal(18, 4)
  // [v3.6] AUTHORITATIVE as of this revision — see the currency
  // re-anchoring note at the top of this file. Always SYP regardless of
  // the ProductUnit's pricingCurrency at sale time — converted server-side
  // at sync (T4c) using that invoice's own exchangeRateUsed if the unit's
  // priceWholesale was set in USD. This is what keeps every historical
  // invoice comparable regardless of what currency a product happened to
  // be priced in on the day it was sold.
  unitPriceSYP Decimal @db.Decimal(18, 4)
  // [v3.6] Informational only — derived (unitPriceSYP ÷ exchangeRateUsed)
  // at the same sync step. Was the authoritative field (always USD,
  // converted from SYP) through v3.5.
  unitPriceUSD Decimal @db.Decimal(18, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a product must never erase line items
  // on past invoices — that would silently corrupt historical invoice
  // totals. Deactivate (Product.isActive = false) instead.
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    ProductUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  // Restrict, matching product/unit above — a batch with sales history
  // attached must never be hard-deletable, even once fully depleted.
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([batchId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  // [v3.6] AUTHORITATIVE as of this revision — see the currency
  // re-anchoring note at the top of this file. No schema change was
  // needed for this model: both currency fields already existed side by
  // side; only which one is treated as the source of truth changed.
  amountSYP     Decimal       @db.Decimal(18, 4)
  // [v3.6] Informational only from this revision forward — derived
  // (amountSYP ÷ exchangeRate). Was the authoritative field through v3.5.
  amountUSD     Decimal       @db.Decimal(18, 4)
  exchangeRate  Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  receiptNo     String?
  notes         String?
  isSynced      Boolean       @default(true)
  offlineId     String?       @unique
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  // Same reasoning as Invoice: append-only by design, no updatedAt.

  // FIX (critical — double-counting bug): distinguishes a payment made AT
  // sale time (auto-created by /api/sync alongside a new Invoice, per T4c)
  // from an independent repayment logged later against existing debt.
  //
  // Invoice.debtAmountSYP is ALREADY computed as totalSYP - paidAmountSYP
  // — i.e., a sale-time payment is already reflected in that number. If
  // the ledger's balance formula (T4e) also subtracted every
  // CustomerPayment row unconditionally, a sale-time payment would be
  // subtracted TWICE: once implicitly (inside debtAmountSYP) and once
  // explicitly (summing CustomerPayment.amountSYP). This column is what
  // lets the ledger tell the two kinds of row apart:
  //   SUM(Invoice.debtAmountSYP)
  //     - SUM(CustomerPayment.amountSYP WHERE invoiceId IS NULL)
  // [v3.6] This formula summed debtAmountUSD/amountUSD through v3.5 — see
  // the currency re-anchoring note at the top of this file.
  //
  // @unique also gives a DB-level guarantee that at most one
  // CustomerPayment can ever be linked to a given invoice.
  //
  // [v3.4] Written as its own top-level prisma.customerPayment.create(...)
  // call inside the same $transaction as the Invoice/InvoiceItem writes —
  // never nested under Invoice.create(...). See the NESTED WRITES note at
  // the top of this file.
  invoiceId String? @unique

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a customer's payment history is financial
  // record, not disposable — same reasoning as Invoice.customer.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

// [v3.6] Deliberately UNCHANGED by the currency re-anchoring above.
// amountUSD here is the platform's own SaaS revenue from the merchant —
// a separate business decision from how a merchant tracks their own
// customers' debt (which is what got re-anchored to SYP). Revisit only if
// that separate decision changes too.
model Subscription {
  id              String                   @id @default(cuid())
  tenantId        String
  // [v3.7] ADDITION (gap #3). T6 names "tier options" as part of merchant
  // checkout but no field previously captured which tier was selected.
  // Kept as a plain String rather than an enum deliberately: the specific
  // tier lineup (and its pricing) is a commercial decision expected to
  // change independently of the schema, and an enum change requires a
  // migration on every deploy whereas a String does not. Validated at the
  // application layer against whatever the current tier list is.
  tier            String
  receiptImageURL String?
  amountUSD       Decimal                  @db.Decimal(18, 4)
  // [v3.7] ADDITION (gap #3). T6 names a "unique Payment Reference Code"
  // the merchant is shown at checkout and writes on their manual transfer,
  // which the Super-Admin then matches against the incoming payment when
  // reviewing the receipt. @unique both prevents two different
  // Subscription rows from accidentally sharing a code and gives the
  // admin dashboard a direct lookup path instead of a manual scan through
  // pending receipts.
  referenceCode   String                   @unique
  status          SubscriptionRecordStatus @default(PENDING_APPROVAL)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status])
}

// [v3.7] ADDITION (gap #1). Represents a B2B storefront order (T5) from
// the moment a retailer submits it until a wholesaler ADMIN approves or
// rejects it. This is deliberately a SEPARATE model from Invoice, not an
// Invoice row created early with status PENDING_REVIEW, for two concrete
// schema-level reasons:
//
//   1. Invoice.userId is required-non-null, referencing a real User who
//      created the sale. A B2B storefront submission has no User session
//      at all — the retailer submitting it is a member of the public, not
//      an authenticated account on this platform. There is no honest value
//      to put in that column at submission time.
//   2. InvoiceItem.batchId is required-non-null, because every InvoiceItem
//      that exists must be traceable to the exact physical batch its stock
//      came from — that traceability is what makes a void's stock reversal
//      correct. But T5 explicitly commits inventory only at APPROVAL time,
//      not at submission time (a pending order must never reserve or
//      decrement stock that a wholesaler might reject hours later). Until
//      approval, there is no batch allocation to record.
//
// Forcing either column to accept a placeholder value (a synthetic "system"
// User, a fabricated batchId) would create exactly the kind of "untested,
// undefined-feeling" edge case this spec already explicitly avoids doing
// for Tenant hard-deletes elsewhere (see the Tenant Lifecycle & Deletion
// Policy note above) — so a dedicated pre-invoice holding model is used
// instead. On approval, the ADMIN who approves becomes Invoice.userId, and
// resolveFifoAllocation runs for the first time (via the identical
// lock-ordering and Preview/Commit-sharing rules as T4c) to assign real
// batchIds — at which point a real Invoice + InvoiceItem(s) are written via
// the standard top-level-calls-in-one-$transaction pattern, and this row is
// updated (its own top-level call) to APPROVED with resultingInvoiceId set.
//
// A rejection never creates any Invoice row at all — it only updates this
// row's own status and rejectionReason, leaving inventory untouched.
model B2BOrderRequest {
  id               String         @id @default(cuid())
  tenantId         String
  // The submitting retailer's own details, captured directly on this row
  // rather than requiring a pre-existing Customer — most first-time B2B
  // submitters have never bought from this tenant before and have no
  // Customer row yet. If approval finds or creates a matching real
  // Customer, that relationship is recorded on the resulting Invoice
  // (Invoice.customerId), not retrofitted onto this row.
  retailerName     String
  retailerPhone    String
  retailerShopName String?
  status           B2BOrderStatus @default(PENDING_REVIEW)
  // Populated only when status = REJECTED — mirrors the free-text
  // reasoning pattern already used for Invoice.voidReason.
  rejectionReason  String?

  // [v3.7] Optional convenience link: if the submitting phone already
  // matches an existing real Customer for this tenant, the approval
  // screen can show that match to the admin before deciding whether to
  // reuse it or create a new Customer row — same soft-duplicate spirit as
  // T4b's walk-in customer check, just surfaced earlier in this flow.
  // SetNull (not Restrict): this is a hint, not a financial record: if the
  // matched Customer is ever deactivated, this order request should not
  // be blocked from anything as a result.
  matchedCustomerId String?
  matchedCustomer   Customer? @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)

  // Set only once, at the moment of approval — see the model-level note
  // above for why this cannot simply be an Invoice row from the start.
  // @unique guarantees an order request can only ever produce one
  // Invoice, mirroring Invoice.voidsInvoiceId's "at most once" pattern.
  resultingInvoiceId String?  @unique
  resultingInvoice   Invoice? @relation(fields: [resultingInvoiceId], references: [id], onDelete: Restrict)

  // Which ADMIN approved or rejected this, and when — required for the
  // wholesaler's own accountability trail, same reasoning as
  // CustomerMergeLog capturing "by which admin" below. Nullable because a
  // freshly submitted, still-PENDING_REVIEW row has neither yet.
  reviewedByUserId String?
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  B2BOrderRequestItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  // [v3.7] Supports T5's per-phone abuse guard directly: "how many
  // PENDING_REVIEW order requests already exist for this phone at this
  // tenant?" without a full table scan — the complementary check to the
  // per-IP @upstash/ratelimit guard, served at the database layer rather
  // than the rate-limiter's own store.
  @@index([tenantId, retailerPhone, status])
}

// [v3.7] ADDITION (gap #1, continued). A single requested line item on a
// still-pending B2B order. Deliberately holds NO batchId (see the
// B2BOrderRequest model-level note for why) — only a snapshot of what was
// requested and at what price, taken at submission time.
model B2BOrderRequestItem {
  id                      String          @id @default(cuid())
  tenantId                String
  orderRequestId          String
  productId               String
  unitId                  String
  quantity                Decimal         @db.Decimal(18, 4)
  // Snapshot of ProductUnit.priceWholesale / pricingCurrency AT THE MOMENT
  // OF SUBMISSION. A merchant may edit priceWholesale on the live
  // ProductUnit row at any time — including in the window between a
  // retailer submitting this order and an admin reviewing it — so the
  // review screen must show what the retailer actually saw and agreed to,
  // not whatever the price happens to be right now. On approval, THIS
  // snapshot (not the live ProductUnit price) is what gets written into
  // the resulting InvoiceItem.unitPriceSYP/unitPriceUSD.
  priceWholesaleSnapshot  Decimal         @db.Decimal(18, 4)
  pricingCurrencySnapshot PricingCurrency

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderRequest B2BOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: same reasoning as InvoiceItem.product/unit —
  // a still-pending or already-approved order request referencing a
  // product must never have that reference silently erased by a product
  // deletion. Products are soft-deleted (isActive = false) instead.
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit         ProductUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderRequestId])
}

// [v3.7] ADDITION (gap #2). T4e requires that a duplicate-customer merge
// be "logged (which two customer IDs, by which admin, when) for audit
// purposes, append-only" — no prior model captured this. Deliberately
// separate from Customer itself (not, say, a `mergedIntoId` column on
// Customer) so that a merge remains a first-class, queryable event in its
// own right, and so a customer could theoretically be merged away and
// still leave a clean audit row behind even though the Customer row
// itself is never hard-deleted (only deactivated) regardless.
model CustomerMergeLog {
  id                  String   @id @default(cuid())
  tenantId            String
  // The Customer row that remains active and now owns every re-pointed
  // Invoice/CustomerPayment row.
  survivingCustomerId String
  // The Customer row that was merged away and deactivated
  // (isActive = false) as part of this same operation.
  mergedCustomerId    String
  performedByUserId   String
  createdAt           DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // survivingCustomer/mergedCustomer/performedByUser are Restrict: this log
  // is itself a financial-audit record and must never be silently orphaned
  // by a later, unrelated data change — consistent with every other
  // financial-record Restrict pattern in this schema (Invoice.customer,
  // CustomerPayment.customer). tenant still cascades, like every other
  // tenant-scoped model in this file.
  survivingCustomer Customer @relation("MergeSurviving", fields: [survivingCustomerId], references: [id], onDelete: Restrict)
  mergedCustomer    Customer @relation("MergeMerged", fields: [mergedCustomerId], references: [id], onDelete: Restrict)
  performedByUser   User     @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([survivingCustomerId])
  @@index([mergedCustomerId])
}
