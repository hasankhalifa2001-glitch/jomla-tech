generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

// A void/refund is never an edit to the original invoice (that would break
// the append-only guarantee everything else here relies on). Instead it's
// a new Invoice row that references the one it reverses — see
// `voidsInvoiceId` below. VOIDED marks that new row itself.
enum InvoiceStatus {
  COMPLETED
  PENDING_REVIEW
  VOIDED
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionRecordStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

// The platform SOW names Sham Cash, Syriatel Cash, and Office Transfer as
// the three real payment rails merchants use — all three must be
// distinguishable in reporting, never collapsed into a free-text field or
// silently bucketed under OTHER.
enum PaymentMethod {
  CASH
  SHAM_CASH
  SYRIATEL_CASH
  BANK_TRANSFER
  OTHER
}

model Tenant {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  logo               String?
  phone              String?
  dailyExchangeRate  Decimal?                 @db.Decimal(18, 4)
  subscriptionStatus TenantSubscriptionStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users            User[]
  products         Product[]
  productUnits     ProductUnit[]
  productBatches   ProductBatch[]
  customers        Customer[]
  invoices         Invoice[]
  invoiceItems     InvoiceItem[]
  customerPayments CustomerPayment[]
  subscriptions    Subscription[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  isPlatformAdmin Boolean  @default(false)
  // Soft-delete flag. A departing cashier/admin gets deactivated, never
  // hard-deleted — see the Restrict note on Invoice.user below for why a
  // real DELETE on this row must never be allowed to succeed anyway.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  category  String?
  isPublic  Boolean  @default(false)
  // Soft-delete flag, same reasoning as User.isActive — a discontinued
  // product's historical InvoiceItems must stay intact.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units        ProductUnit[]
  batches      ProductBatch[]
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ProductUnit {
  id               String  @id @default(cuid())
  // Denormalized from Product so this table is directly reachable by
  // tenantId — needed both for RLS to apply to it directly (previously it
  // was only isolated transitively through its parent Product) and to
  // scope barcode uniqueness per tenant below.
  tenantId         String
  productId        String
  unitName         String
  conversionFactor Decimal @db.Decimal(18, 4)
  priceUSD         Decimal @db.Decimal(18, 4)
  barcode          String?

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches      ProductBatch[]
  invoiceItems InvoiceItem[]

  // Barcodes are a global standard — two different tenants can legitimately
  // sell the same imported item under the same barcode. Uniqueness is
  // scoped per tenant, not platform-wide. Postgres treats NULL as distinct
  // from every other NULL in a unique constraint, so this does not block
  // multiple products from having no barcode at all.
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
}

model ProductBatch {
  id          String    @id @default(cuid())
  // Same reasoning as ProductUnit.tenantId above.
  tenantId    String
  productId   String
  unitId      String
  batchNumber String
  // Can legitimately go negative: if two cashiers sell the last unit of a
  // batch while both offline, we let the sale through and flag it for the
  // merchant to reconcile on sync, rather than blocking a sale a paper
  // ledger would never have blocked either. Do not add a non-negative
  // constraint or a @default(0) validation on this field without revisiting
  // that decision first.
  quantity    Decimal   @db.Decimal(18, 4)
  expiryDate  DateTime?
  // resolveFifoAllocation's tie-break (when two batches share the same
  // expiryDate, or both have none) sorts on this column explicitly,
  // instead of falling back to comparing `id` as a string — an
  // implementation detail of cuid's embedded timestamp, not a documented
  // ordering guarantee. fifo.ts (T3) depends on this column directly.
  createdAt   DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         ProductUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@index([productId])
  @@index([unitId])
  @@index([expiryDate])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  shopName  String?
  // Soft-delete flag — a customer with any invoice/payment history must
  // never be hard-deletable (see Restrict notes below).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // T4 walk-in customer sync: mirrors the offlineId pattern already used
  // on Invoice and CustomerPayment. A walk-in customer created on the POS
  // while offline is assigned a client-generated UUID at creation time
  // (Dexie's offlineCustomers.offlineId) — /api/sync MUST look up an
  // existing Customer by this value BEFORE creating a new row, across
  // separate sync requests over time, not just within one request's
  // in-memory map. This @unique constraint is the last line of defense
  // against a duplicate: the API implementation must still catch a P2002
  // race (two near-simultaneous sync attempts both passing the pre-check)
  // and re-look-up the existing row rather than surfacing the error raw —
  // the pre-check alone is not atomic.
  offlineId String? @unique

  // Deliberately no balanceDebtUSD column here — net debt is always
  // computed on-the-fly as SUM(Invoice.debtAmountUSD) - SUM(CustomerPayment.amountUSD)
  // to avoid a stored balance drifting from the transaction history.

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments CustomerPayment[]

  @@index([tenantId])
  @@index([offlineId])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  customerId       String
  totalUSD         Decimal       @db.Decimal(18, 4)
  totalSYP         Decimal       @db.Decimal(18, 4)
  exchangeRateUsed Decimal       @db.Decimal(18, 4)
  paidAmountUSD    Decimal       @db.Decimal(18, 4)
  debtAmountUSD    Decimal       @db.Decimal(18, 4)
  isPaid           Boolean       @default(false)
  status           InvoiceStatus @default(COMPLETED)
  isSynced         Boolean       @default(true)
  offlineId        String?       @unique
  syncedAt         DateTime?
  createdAt        DateTime      @default(now())
  // No updatedAt: invoices are append-only. Corrections happen via a new
  // void/refund invoice (below) or a new CustomerPayment, never by editing
  // a past invoice in place.

  // A void/refund is its own Invoice row with status VOIDED, whose amounts
  // reverse the original. This field is set ONLY on that reversing row,
  // and points back at the invoice it voids. The original invoice is
  // never edited or flagged itself — its debt contribution is simply
  // offset once the reversing row's amounts are included in the SUM()
  // that computes customer debt. @unique here also means, at the DB
  // level, an invoice can be voided at most once — a second void attempt
  // against the same original fails the constraint outright, independent
  // of whatever UI/app-level check also guards against it.
  voidsInvoiceId String?  @unique
  voidsInvoice   Invoice? @relation("InvoiceVoid", fields: [voidsInvoiceId], references: [id], onDelete: Restrict)
  voidedBy       Invoice? @relation("InvoiceVoid")
  // Free-text reason captured at the moment of voiding (T4 Scope 4:
  // "Requires a reason (free text, audit trail) at the time of voiding").
  // Populated only on a VOIDED-status row; always null on a normal sale.
  voidReason     String?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a cashier/admin must never silently
  // delete every invoice they ever created. Deactivate the user
  // (User.isActive = false) instead — the DB now refuses a hard delete
  // while any invoice still references them.
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Restrict, not Cascade: same reasoning — a customer's debt and purchase
  // history is exactly the record this platform exists to preserve.
  // Deactivate (Customer.isActive = false) instead of deleting.
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  // Same reasoning as ProductUnit.tenantId above.
  tenantId     String
  invoiceId    String
  productId    String
  unitId       String
  // Every line item must record exactly which physical batch its stock
  // came from. This is what makes FIFO deduction traceable, what a VOIDED
  // invoice's reversal writes stock back to, and it's the column
  // resolveFifoAllocation's result (T3/T4) is written into.
  //
  // BUSINESS RULE: if a sold quantity spans more than one batch (the
  // nearest batch doesn't have enough left), split it into multiple
  // InvoiceItem rows on the SAME invoice — one per batch — never a single
  // row spanning batches.
  batchId      String
  quantity     Decimal @db.Decimal(18, 4)
  unitPriceUSD Decimal @db.Decimal(18, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a product must never erase line items
  // on past invoices — that would silently corrupt historical invoice
  // totals. Deactivate (Product.isActive = false) instead; a discontinued
  // product still needs to render correctly on old invoices.
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    ProductUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  // Restrict, matching product/unit above — a batch with sales history
  // attached must never be hard-deletable, even once fully depleted, and
  // this is also the target a VOIDED invoice's negative-quantity items
  // write their stock return back to.
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([batchId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  amountUSD     Decimal       @db.Decimal(18, 4)
  amountSYP     Decimal       @db.Decimal(18, 4)
  exchangeRate  Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  receiptNo     String?
  notes         String?
  isSynced      Boolean       @default(true)
  offlineId     String?       @unique
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  // Same reasoning as Invoice: append-only by design, no updatedAt.

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: a customer's payment history is financial
  // record, not disposable — same reasoning as Invoice.customer.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model Subscription {
  id              String                   @id @default(cuid())
  tenantId        String
  receiptImageURL String?
  amountUSD       Decimal                  @db.Decimal(18, 4)
  status          SubscriptionRecordStatus @default(PENDING_APPROVAL)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status])
}
