generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// [v4.0] UNIT ARCHITECTURE FIX — BASE-UNIT MODEL (see UNIT-ARCHITECTURE.md
// for the full narrative). Replaces the v3.x design where ProductBatch.unitId
// could point at ANY ProductUnit (طرد, قطعة, كرتونة...) and every read/write
// path had to convert quantities back and forth between whichever units
// happened to be involved, using native JS math. That repeated conversion
// accumulated floating-point error (e.g. "21.9984 قطعة" instead of "24
// قطعة" for a single طرد) and had no single source of truth for "how much
// physical stock actually exists."
//
// THE FIX: every Product now has exactly ONE physical base unit
// (Product.baseUnitId). ProductBatch.quantity is ALWAYS expressed in that
// base unit — never in "طرد", never in whatever unit the merchant happened
// to be typing into at that moment. Every other ProductUnit for that
// product (طرد, كرتونة, etc.) is a pure PRESENTATION/SALE convenience: its
// conversionFactor states "how many base units equal ONE of this unit."
// Conversion into/out of the base unit happens exactly once, at the moment
// of sale/adjustment/report — never chained, never stored as an
// intermediate value, and never computed with a native JS number. See
// lib/inventory/units.ts (documented in UNIT-ARCHITECTURE.md) — the single
// sanctioned place in the codebase allowed to call conversionFactor.
//
// [v4.0, corrected] IMPORTANT: requireBaseUnit() (lib/inventory/base-unit.ts)
// resolves the BASE unit only (conversionFactor always 1). It is NEVER the
// source of the conversion factor used to convert a sold/ordered quantity
// into base units — that factor always comes from the actually-sold/ordered
// ProductUnit row itself (looked up via its own unitId, e.g. on InvoiceItem
// or B2BOrderRequestItem). requireBaseUnit()'s only job in a write path is
// telling the caller which unitId every ProductBatch is scoped under, for
// locking/FIFO purposes. See T4c/T5 in the spec for the corrected write-path
// description.
//
// Also new in this revision: BaseUnitChangeLog (see below, near
// StockAdjustment/BatchDeletionLog) — the append-only audit trail for the
// rare, zero-batch-only correction of a product's designated base unit.
// ============================================================================

// ============================================================================
// v3.4 TENANT ISOLATION NOTE (see lib/db/tenant-scope.ts, not represented in
// this file since Prisma has no schema-level construct for it):
//
// PHASE 1 (launch): a Prisma Client Extension wraps every generated model
// method and injects `tenantId` from the authenticated session automatically.
// The ONE raw query in this system (T4c's `SELECT ... FOR UPDATE` batch lock)
// is exempted from that extension's typed interception, so it goes through a
// dedicated wrapper instead:
//
//   async function tenantScopedRawQuery<T>(
//     tx: Prisma.TransactionClient,
//     tenantId: string,          // required at the TYPE level — a call site
//     sql: Prisma.Sql            // missing this argument fails to compile.
//   ): Promise<T> {
//     return tx.$queryRaw`${sql} AND tenant_id = ${tenantId}`;
//   }
//
// An ESLint rule blocks any direct `$queryRaw`/`$queryRawUnsafe` call outside
// that one file. CI fails the build on violation.
//
// [v3.4] NESTED WRITES — PROJECT-WIDE RULE, NOT JUST T4:
// NO nested create/update/upsert/set/disconnect targeting a tenant-scoped
// model, anywhere in the codebase. Every write to a tenant-scoped model is
// its own top-level prisma.model.<method>(...) call, issued inside the same
// $transaction as any related writes it must stay atomic with. Enforced via
// an ESLint rule; CI fails the build on violation.
//
// PHASE 2 (hardening): real Postgres RLS — see prior revisions for the full
// rollout plan (ENABLE/FORCE ROW LEVEL SECURITY, a non-owner runtime DB
// role, tenantTransaction() issuing SET LOCAL app.tenant_id, hand-written
// migration policies, T7's cross-tenant test suite as compensating control).
// ============================================================================

// ============================================================================
// [v3.6] CURRENCY RE-ANCHORING NOTE: SYP is authoritative for every merchant-
// facing financial record (Invoice.totalSYP/paidAmountSYP/debtAmountSYP,
// CustomerPayment.amountSYP, InvoiceItem.unitPriceSYP). USD counterparts are
// derived/informational only, computed via the frozen exchangeRateUsed/
// exchangeRate — never validated against, never gate any action. The one
// exception is Subscription.amountUSD (the platform's own SaaS revenue).
// ============================================================================

enum UserRole {
  ADMIN
  CASHIER
}

enum InvoiceStatus {
  COMPLETED
  PENDING_REVIEW
  VOIDED
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionRecordStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

enum PaymentMethod {
  CASH
  SHAM_CASH
  SYRIATEL_CASH
  BANK_TRANSFER
  OTHER
}

enum PricingCurrency {
  USD
  SYP
}

enum BarcodeSource {
  GS1
  INTERNAL
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum B2BOrderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CustomerMergeRecordType {
  INVOICE
  PAYMENT
}

model Tenant {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  logo               String?
  phone              String?
  dailyExchangeRate  Decimal?                 @db.Decimal(18, 4)
  subscriptionStatus TenantSubscriptionStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users                 User[]
  products              Product[]
  productUnits          ProductUnit[]
  productBatches        ProductBatch[]
  customers             Customer[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  customerPayments      CustomerPayment[]
  subscriptions         Subscription[]
  b2bOrderRequests      B2BOrderRequest[]
  customerMergeLogs     CustomerMergeLog[]
  customerMergeLogItems CustomerMergeLogItem[]
  stockAdjustments      StockAdjustment[]
  batchDeletionLogs     BatchDeletionLog[]
  // [v4.0]
  baseUnitChangeLogs    BaseUnitChangeLog[]

  systemCustomerId     String?               @unique
  systemCustomer       Customer?             @relation("TenantSystemCustomer", fields: [systemCustomerId], references: [id], onDelete: Restrict)
  b2bOrderRequestItems B2BOrderRequestItem[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  reviewedB2BOrderRequests B2BOrderRequest[]
  customerMergeLogs        CustomerMergeLog[]
  stockAdjustments         StockAdjustment[]
  batchDeletionLogs        BatchDeletionLog[]
  // [v4.0]
  baseUnitChangeLogs       BaseUnitChangeLog[]

  @@index([tenantId])
}

model Product {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  category String?
  isPublic Boolean @default(false)
  isActive Boolean @default(true)

  // [v4.0] ADDITION — the structural guarantee of "exactly one physical
  // base unit per product." Every ProductBatch.quantity for this product is
  // expressed in this unit and this unit alone. @unique because a
  // ProductUnit can be the base unit of at most one Product (mirrors the
  // Tenant.systemCustomerId pattern used elsewhere in this schema for the
  // exact same "structural, not just conventional, one-to-one" reason).
  //
  // TYPE-LEVEL HONESTY, NOT A LOOPHOLE: this field is String? because
  // Prisma has no way to express "non-null after row creation" — but that
  // does NOT mean application code is free to treat it as usually-present.
  // Product.create() and Product.update({ baseUnitId }) both happen inside
  // ONE $transaction (see lib/inventory/product-create.ts) — a concurrent
  // reader outside that transaction never observes a committed Product row
  // with baseUnitId still null; a crash mid-transaction rolls back the
  // whole thing, leaving no row at all rather than a half-built one (same
  // pattern as T2a's four-write onboarding transaction). The ONLY place
  // permitted to read `.baseUnitId` / `.baseUnit` directly off a Prisma
  // result is lib/inventory/base-unit.ts's requireBaseUnit() — every other
  // call site (POS, inventory screen, sync, B2B approval, CSV import) goes
  // through that function, which returns a non-null ProductUnit or throws
  // MissingBaseUnitError loud and immediately. This mirrors T1's own
  // tenantScopedRawQuery() pattern: the schema stays honest about what CAN
  // happen (a bug), while exactly one guarded chokepoint is what the rest
  // of the codebase is allowed to trust. An ESLint rule (identical
  // mechanism to the $queryRaw and nested-write rules) blocks any direct
  // `.baseUnitId` / `.baseUnit` property access outside that one file; CI
  // fails the build on violation. See UNIT-ARCHITECTURE.md §9 for the
  // full guard code and required tests.
  //
  // [v4.0, corrected] requireBaseUnit() never supplies a conversionFactor
  // for anything other than the base unit itself (always 1). Converting a
  // sold/ordered quantity into base units always uses that sold/ordered
  // unit's OWN conversionFactor, fetched via its own unitId — see
  // InvoiceItem.unitId / B2BOrderRequestItem.unitId below.
  baseUnitId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: a base unit can never be silently detached by a cascading
  // delete — a Product with any batch history depends on this relation to
  // know what physical unit its stock is even counted in. Changing which
  // unit is the base unit after creation is not supported for a product
  // with any ProductBatch (see UNIT-ARCHITECTURE.md, "Why the base unit is
  // immutable"); for a zero-batch product, a correction is possible but
  // must write a BaseUnitChangeLog row (see below).
  baseUnit ProductUnit? @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  units                ProductUnit[]         @relation("ProductUnits")
  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  b2bOrderRequestItems B2BOrderRequestItem[]
  // [v4.0]
  baseUnitChangeLogs   BaseUnitChangeLog[]

  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ProductUnit {
  id        String @id @default(cuid())
  tenantId  String
  productId String
  unitName  String

  // conversionFactor — [v4.0] one fixed, uniform meaning for every row: "how
  // many base units (Product.baseUnitId) equal ONE of this ProductUnit?" The
  // base unit's own row is forced to conversionFactor = 1 always, and can
  // never be edited after creation as long as the product has any ProductBatch.
  // Any conversion using this field goes exclusively through lib/inventory/units.ts
  // (toBaseUnit/fromBaseUnit/breakdownForDisplay) — no direct quantity *
  // conversionFactor computation is permitted anywhere else, enforced by a
  // dedicated ESLint rule using the same mechanism as the tenant-scope rules.
  //
  // [v4.0, corrected] When converting a sale/order line into base units,
  // ALWAYS use THIS row's own conversionFactor (the unit actually sold in),
  // never the base unit's (which is always 1 and would apply no conversion
  // at all). requireBaseUnit() is not involved in this arithmetic.
  conversionFactor Decimal @db.Decimal(18, 4)

  pricingCurrency PricingCurrency @default(SYP)
  priceWholesale  Decimal         @db.Decimal(18, 4)
  priceRetail     Decimal?        @db.Decimal(18, 4)
  isActive        Boolean         @default(true)
  imageUrl        String?
  barcode         String?
  barcodeSource   BarcodeSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation("ProductUnits", fields: [productId], references: [id], onDelete: Cascade)

  // [v4.0] Reverse side of Product.baseUnitId — lets a ProductUnit row know
  // it is wired up as its product's base unit, if it is. At most one
  // Product can point back here, enforced by @unique on Product.baseUnitId.
  isBaseUnitOf Product? @relation("ProductBaseUnit")

  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  b2bOrderRequestItems B2BOrderRequestItem[]
  // [v4.0] the two sides of a base-unit correction event — see
  // BaseUnitChangeLog below.
  baseUnitChangesFrom  BaseUnitChangeLog[]   @relation("BaseUnitChangeOld")
  baseUnitChangesTo    BaseUnitChangeLog[]   @relation("BaseUnitChangeNew")

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, isActive])
}

model ProductBatch {
  id        String @id @default(cuid())
  tenantId  String
  productId String

  // [v4.0] REDEFINED — no longer "whichever unit the merchant was entering
  // stock in." This now ALWAYS equals Product.baseUnitId for the same
  // productId, enforced at the application layer on every write path
  // (batch creation, CSV import, seed script) — never accepted as a free
  // choice from the client. Every write path resolves this value via
  // requireBaseUnit(tx, tenantId, productId) (lib/inventory/base-unit.ts) —
  // never a client-supplied unitId, and never a direct baseUnitId field
  // read (see the guard note on Product.baseUnitId above). The relation
  // itself still points at ProductUnit (not duplicated as a denormalized
  // flag) so existing joins (FIFO ordering, InvoiceItem.batch.unit
  // displays) keep working unchanged; what changed is the WRITE-TIME
  // GUARANTEE on which unit that relation is allowed to reference.
  unitId      String
  batchNumber String
  // Always expressed in the product's base unit — see the note on
  // Product.baseUnitId above. Never a "طرد" count, never a "كرتونة" count.
  quantity    Decimal   @db.Decimal(18, 4)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         ProductUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  adjustments  StockAdjustment[]

  @@index([tenantId])
  @@index([productId])
  @@index([unitId])
  @@index([expiryDate])
  @@index([tenantId, quantity])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  shopName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isSystemGenerated      Boolean @default(false)
  tenantAsSystemCustomer Tenant? @relation("TenantSystemCustomer")

  offlineId String? @unique

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments CustomerPayment[]

  mergesAsSurvivor          CustomerMergeLog[] @relation("MergeSurviving")
  mergesAsMerged            CustomerMergeLog[] @relation("MergeMerged")
  matchedByB2BOrderRequests B2BOrderRequest[]

  @@index([tenantId])
  @@index([offlineId])
  @@index([tenantId, phone])
  @@index([tenantId, isSystemGenerated])
}

model VerifiedRetailer {
  id                String   @id @default(cuid())
  phone             String   @unique
  shopName          String?
  firstVerifiedAt   DateTime @default(now())
  verificationCount Int      @default(1)

  @@index([phone])
}

model ProductCatalogEntry {
  id              String   @id @default(cuid())
  barcode         String   @unique
  name            String
  category        String?
  imageUrl        String?
  addedByTenantId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reports ProductCatalogEntryReport[]

  @@index([barcode])
  @@index([addedByTenantId])
}

model ProductCatalogEntryReport {
  id                 String       @id @default(cuid())
  catalogEntryId     String
  reportedByTenantId String
  reason             String
  suggestedName      String?
  suggestedCategory  String?
  suggestedImageUrl  String?
  status             ReportStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  resolvedAt         DateTime?

  catalogEntry ProductCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([catalogEntryId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  customerId       String
  totalSYP         Decimal       @db.Decimal(18, 4)
  totalUSD         Decimal       @db.Decimal(18, 4)
  exchangeRateUsed Decimal       @db.Decimal(18, 4)
  paidAmountSYP    Decimal       @db.Decimal(18, 4)
  paidAmountUSD    Decimal       @db.Decimal(18, 4)
  debtAmountSYP    Decimal       @db.Decimal(18, 4)
  debtAmountUSD    Decimal       @db.Decimal(18, 4)
  isPaid           Boolean       @default(false)
  status           InvoiceStatus @default(COMPLETED)
  isSynced         Boolean       @default(true)
  offlineId        String?       @unique
  syncedAt         DateTime?
  receiptPdfUrl    String?
  createdAt        DateTime      @default(now())

  voidsInvoiceId String?  @unique
  voidsInvoice   Invoice? @relation("InvoiceVoid", fields: [voidsInvoiceId], references: [id], onDelete: Restrict)
  voidedBy       Invoice? @relation("InvoiceVoid")

  voidReason String?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  payment CustomerPayment?

  b2bOrderRequest B2BOrderRequest?

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String

  // [v4.0] NOTE — this still records the ProductUnit that was actually SOLD
  // (e.g. "طرد"), NOT necessarily the product's base unit. This is
  // deliberate and unchanged: a customer buys and is billed in whichever
  // unit they chose at the register. What changed is only how `quantity`
  // here relates to ProductBatch.quantity: the sale-time conversion from
  // "N of this sold unit" into "N × conversionFactor of the batch's base
  // unit" happens exactly once, through lib/inventory/units.ts, at the
  // moment stock is drawn down (T4c/T5's commitFifoAllocation call) — see
  // UNIT-ARCHITECTURE.md, "Selling in a non-base unit."
  //
  // [v4.0, corrected] The conversionFactor used for that conversion is
  // ALWAYS read from THIS unit row (via this unitId) — never from
  // requireBaseUnit(), which resolves an unrelated base-unit row whose
  // conversionFactor is always 1.
  unitId String

  batchId      String
  // Quantity SOLD, expressed in `unitId` above (the unit the customer
  // actually bought) — e.g. "3" meaning 3 طرد. NOT automatically the same
  // number as how much was deducted from ProductBatch.quantity, which is
  // always in the batch's base unit. The relationship between the two is
  // always: batchQuantityDeducted = quantity × unitId.conversionFactor,
  // computed once via decimal.js at commit time and never re-derived
  // afterward from anything other than this stored quantity + unit.
  quantity     Decimal @db.Decimal(18, 4)
  unitPriceSYP Decimal @db.Decimal(18, 4)
  unitPriceUSD Decimal @db.Decimal(18, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    ProductUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([batchId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  amountSYP     Decimal       @db.Decimal(18, 4)
  amountUSD     Decimal       @db.Decimal(18, 4)
  exchangeRate  Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  receiptNo     String?
  notes         String?
  isSynced      Boolean       @default(true)
  offlineId     String?       @unique
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())

  invoiceId String? @unique

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model Subscription {
  id              String                   @id @default(cuid())
  tenantId        String
  tier            String
  receiptImageURL String?
  amountUSD       Decimal                  @db.Decimal(18, 4)
  referenceCode   String                   @unique
  status          SubscriptionRecordStatus @default(PENDING_APPROVAL)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status])
}

model B2BOrderRequest {
  id               String         @id @default(cuid())
  tenantId         String
  retailerName     String
  retailerPhone    String
  retailerShopName String?
  status           B2BOrderStatus @default(PENDING_REVIEW)
  rejectionReason  String?

  matchedCustomerId String?
  matchedCustomer   Customer? @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)

  resultingInvoiceId String?  @unique
  resultingInvoice   Invoice? @relation(fields: [resultingInvoiceId], references: [id], onDelete: Restrict)

  reviewedByUserId String?
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  B2BOrderRequestItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, retailerPhone, status])
}

model B2BOrderRequestItem {
  id             String  @id @default(cuid())
  tenantId       String
  orderRequestId String
  productId      String
  // [v4.0] NOTE — same meaning as InvoiceItem.unitId: the unit the retailer
  // actually selected to order in, not necessarily the base unit. The
  // snapshot below freezes price only; the quantity→base-unit conversion
  // still happens once, at approval time, via lib/inventory/units.ts.
  //
  // [v4.0, corrected] The conversionFactor used for that conversion is
  // ALWAYS read from THIS unit row (via this unitId) — never from
  // requireBaseUnit(), and never from priceWholesaleSnapshot /
  // pricingCurrencySnapshot below, which cover pricing only.
  unitId         String
  quantity       Decimal @db.Decimal(18, 4)

  priceWholesaleSnapshot  Decimal         @db.Decimal(18, 4)
  pricingCurrencySnapshot PricingCurrency

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderRequest B2BOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit         ProductUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderRequestId])
}

model CustomerMergeLog {
  id                  String   @id @default(cuid())
  tenantId            String
  survivingCustomerId String
  mergedCustomerId    String   @unique
  performedByUserId   String
  createdAt           DateTime @default(now())

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survivingCustomer Customer               @relation("MergeSurviving", fields: [survivingCustomerId], references: [id], onDelete: Restrict)
  mergedCustomer    Customer               @relation("MergeMerged", fields: [mergedCustomerId], references: [id], onDelete: Restrict)
  performedByUser   User                   @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  items             CustomerMergeLogItem[]

  @@index([tenantId])
  @@index([survivingCustomerId])
}

model CustomerMergeLogItem {
  id         String                  @id @default(cuid())
  tenantId   String
  mergeLogId String
  recordType CustomerMergeRecordType
  // [v4.2] recordId is a plain String, not a live FK — it can point at either
  // an Invoice.id or a CustomerPayment.id depending on recordType, and Prisma
  // has no polymorphic-FK construct to express that. Consistent with
  // BatchDeletionLog.batchId's own "snapshot, not a live relation" pattern.
  recordId   String
  createdAt  DateTime                @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergeLog CustomerMergeLog @relation(fields: [mergeLogId], references: [id], onDelete: Restrict)

  @@unique([mergeLogId, recordType, recordId])
  @@index([tenantId])
  @@index([mergeLogId])
  @@index([recordId])
}

model StockAdjustment {
  id               String   @id @default(cuid())
  tenantId         String
  batchId          String
  adjustedByUserId String
  // [v4.0] NOTE — always in the batch's base unit, same as
  // ProductBatch.quantity itself. A reconciliation screen that lets an
  // ADMIN type the correction in a non-base unit (e.g. "طرد ناقص واحد")
  // must convert it to the base unit via lib/inventory/units.ts BEFORE
  // writing this row — quantityDelta itself is never stored in any unit
  // other than the base unit.
  quantityDelta    Decimal  @db.Decimal(18, 4)
  reason           String
  createdAt        DateTime @default(now())

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch          ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  adjustedByUser User         @relation(fields: [adjustedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([batchId])
}

model BatchDeletionLog {
  id       String @id @default(cuid())
  tenantId String

  batchId            String
  productId          String
  unitId             String
  batchNumber        String
  // [v4.0] NOTE — snapshot is in the base unit, consistent with the batch's
  // own quantity field at the moment it existed.
  quantityAtDeletion Decimal  @db.Decimal(18, 4)
  deletedByUserId    String
  reason             String
  createdAt          DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedByUser User   @relation(fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([batchId])
}

// ============================================================================
// [v4.0, new] BaseUnitChangeLog — append-only audit trail for the rare,
// zero-batch-only correction of a product's designated base unit (see
// UNIT-ARCHITECTURE.md's Immutability rule). Same pattern as
// StockAdjustment/BatchDeletionLog: append-only, no updatedAt, every
// relation Restrict. ADMIN-only per T2b's Role Capability Matrix.
//
// This model exists specifically to back the audit-logging promise made in
// the spec's Unit Conversion Architecture section — a base-unit correction
// on a zero-batch product is never a silent field edit.
// ============================================================================
model BaseUnitChangeLog {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  oldBaseUnitId   String
  newBaseUnitId   String
  changedByUserId String
  reason          String
  createdAt       DateTime @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  oldBaseUnit   ProductUnit @relation("BaseUnitChangeOld", fields: [oldBaseUnitId], references: [id], onDelete: Restrict)
  newBaseUnit   ProductUnit @relation("BaseUnitChangeNew", fields: [newBaseUnitId], references: [id], onDelete: Restrict)
  changedByUser User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([productId])
}
