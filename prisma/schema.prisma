generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// [v4.0] UNIT ARCHITECTURE FIX — BASE-UNIT MODEL (see UNIT-ARCHITECTURE.md
// for the full narrative). Replaces the v3.x design where ProductBatch.unitId
// could point at ANY ProductUnit (طرد, قطعة, كرتونة...) and every read/write
// path had to convert quantities back and forth between whichever units
// happened to be involved, using native JS math. That repeated conversion
// accumulated floating-point error (e.g. "21.9984 قطعة" instead of "24
// قطعة" for a single طرد) and had no single source of truth for "how much
// physical stock actually exists."
//
// THE FIX: every Product now has exactly ONE physical base unit
// (Product.baseUnitId). ProductBatch.quantity is ALWAYS expressed in that
// base unit — never in "طرد", never in whatever unit the merchant happened
// to be typing into at that moment. Every other ProductUnit for that
// product (طرد, كرتونة, etc.) is a pure PRESENTATION/SALE convenience: its
// conversionFactor states "how many base units equal ONE of this unit."
// Conversion into/out of the base unit happens exactly once, at the moment
// of sale/adjustment/report — never chained, never stored as an
// intermediate value, and never computed with a native JS number. See
// lib/inventory/units.ts (documented in UNIT-ARCHITECTURE.md) — the single
// sanctioned place in the codebase allowed to call conversionFactor.
//
// [v4.0, corrected] IMPORTANT: requireBaseUnit() (lib/inventory/base-unit.ts)
// resolves the BASE unit only (conversionFactor always 1). It is NEVER the
// source of the conversion factor used to convert a sold/ordered quantity
// into base units — that factor always comes from the actually-sold/ordered
// ProductUnit row itself (looked up via its own unitId, e.g. on InvoiceItem
// or B2BOrderRequestItem). requireBaseUnit()'s only job in a write path is
// telling the caller which unitId every ProductBatch is scoped under, for
// locking/FIFO purposes. See T4c/T5 in the spec for the corrected write-path
// description.
//
// Also new in this revision: BaseUnitChangeLog (see below, near
// StockAdjustment/BatchDeletionLog) — the append-only audit trail for the
// rare, zero-batch-only correction of a product's designated base unit.
// ============================================================================

// ============================================================================
// v3.4 TENANT ISOLATION NOTE (see lib/db/tenant-scope.ts, not represented in
// this file since Prisma has no schema-level construct for it):
//
// PHASE 1 (launch): a Prisma Client Extension wraps every generated model
// method and injects `tenantId` from the authenticated session automatically.
// The ONE raw query in this system (T4c's `SELECT ... FOR UPDATE` batch lock)
// is exempted from that extension's typed interception, so it goes through a
// dedicated wrapper instead:
//
//   async function tenantScopedRawQuery<T>(
//     tx: Prisma.TransactionClient,
//     tenantId: string,          // required at the TYPE level — a call site
//     sql: Prisma.Sql            // missing this argument fails to compile.
//   ): Promise<T> {
//     return tx.$queryRaw`${sql} AND tenant_id = ${tenantId}`;
//   }
//
// An ESLint rule blocks any direct `$queryRaw`/`$queryRawUnsafe` call outside
// that one file. CI fails the build on violation.
//
// [v3.4] NESTED WRITES — PROJECT-WIDE RULE, NOT JUST T4:
// NO nested create/update/upsert/set/disconnect targeting a tenant-scoped
// model, anywhere in the codebase. Every write to a tenant-scoped model is
// its own top-level prisma.model.<method>(...) call, issued inside the same
// $transaction as any related writes it must stay atomic with. Enforced via
// an ESLint rule; CI fails the build on violation.
//
// PHASE 2 (hardening): real Postgres RLS — see prior revisions for the full
// rollout plan (ENABLE/FORCE ROW LEVEL SECURITY, a non-owner runtime DB
// role, tenantTransaction() issuing SET LOCAL app.tenant_id, hand-written
// migration policies, T7's cross-tenant test suite as compensating control).
// ============================================================================

// ============================================================================
// [v3.6] CURRENCY RE-ANCHORING NOTE: SYP is authoritative for every merchant-
// facing financial record (Invoice.totalSYP/paidAmountSYP/debtAmountSYP,
// CustomerPayment.amountSYP, InvoiceItem.unitPriceSYP). USD counterparts are
// derived/informational only, computed via the frozen exchangeRateUsed/
// exchangeRate — never validated against, never gate any action. The one
// exception is Subscription.amountUSD (the platform's own SaaS revenue).
// ============================================================================

// ============================================================================
// [v4.2] BATCH PURCHASE COST NOTE: ProductBatch.costPricePerBaseUnit and
// InvoiceItem.costAmountSYP back T4g's profit-tracking feature.
// CostPriceChangeLog is the append-only audit trail for correcting an
// existing batch's cost price. All three (plus BatchDeletionLog's
// costPriceAtDeletion snapshot) are always SYP-denominated, with no
// pricingCurrency counterpart — an internal bookkeeping figure, never a
// customer-facing price.
//
// [v4.3] STOCKADJUSTMENT FIX: StockAdjustment.batchId is a plain snapshot
// field (with productId/unitId/batchNumber snapshots alongside it), not a
// live @relation to ProductBatch — see the note on the StockAdjustment
// model below for the full rationale. This is a fix to the base T1/T3c
// spec, surfaced during T4g's design but independent of it.
//
// [v4.3, rev.4] Performance indexes added on StockAdjustment and
// CostPriceChangeLog: @@index([tenantId, batchId]) alongside the existing
// single-column indexes — the real query pattern for both (T3c's
// adjustment-history panel, and any future cost-change history panel) is
// always "this tenant's rows for this batchId," never batchId alone across
// tenants. The single-column @@index([tenantId]) is kept for general
// tenant-scoped listing/paging queries that don't filter by batch at all.
//
// [v4.4] PRE-LAUNCH SIMPLIFICATION: this platform has not yet been used in
// production and carries no real pre-existing data. Every null-permitting
// "migration/backfill" accommodation that existed in v4.2–v4.3 is removed
// as unnecessary complexity — there is no "cost not yet set" state to
// protect data that does not exist:
//   - ProductBatch.costPricePerBaseUnit is now REQUIRED (non-nullable).
//     Mandatory at batch-creation time on every creation path (single-batch
//     entry, the multi-product receipt screen, CSV import), ADMIN-only.
//   - InvoiceItem.costAmountSYP is now REQUIRED (non-nullable) — every
//     batch always has a cost price, so this is always computable at
//     commit time. No null-exclusion branch exists anywhere profit is
//     calculated (T4c2, T4h).
//   - CostPriceChangeLog.oldCostPrice is now REQUIRED (non-nullable) —
//     every correction always has a real prior value to record; there is
//     no first-time-backfill case.
//   - BatchDeletionLog.costPriceAtDeletion is now REQUIRED (non-nullable)
//     — every batch always has a real cost price by the time it could be
//     deleted.
//   - The @@index([tenantId, costPricePerBaseUnit]) index that used to back
//     the "batches with no cost price set" backfill filter/banner has been
//     REMOVED — that filter no longer exists, since the null state it
//     searched for can never occur.
//   - StockAdjustment's three-step data migration (add nullable → backfill
//     → convert to NOT NULL) is likewise no longer relevant — there is no
//     pre-existing data to migrate. The model below is simply the correct
//     schema from day one.
//   - This revision also standardizes ProductBatch.batchNumber's format
//     ({server-date}-{required merchant text}) and adds a multi-product
//     batch receipt screen — neither requires any schema change;
//     batchNumber is already a plain String, and the new screen simply
//     creates multiple ProductBatch rows sharing one batchNumber inside a
//     single $transaction. Purely an application-layer change.
// ============================================================================

// ============================================================================
// [v4.5] MULTI-BARCODE SUPPORT — closes a real-world gap found during
// merchant field testing: a single ProductUnit often carries MORE THAN ONE
// barcode (e.g. a detergent line where the manufacturer prints a different
// barcode per scent/variant, but the merchant tracks it as one stock item
// with one price and one batch history). The old design (a scalar
// ProductUnit.barcode/barcodeSource pair, unique per tenant) could only
// ever represent one barcode per unit.
//
// THE FIX: ProductUnit.barcode/barcodeSource are REMOVED. A new tenant-
// scoped model, ProductUnitBarcode, holds zero, one, or many barcode rows
// per unit. This is purely additive to the multi-unit architecture above —
// InvoiceItem/B2BOrderRequestItem still key off unitId, never off a
// barcode, so nothing about FIFO, sync, void, or the ledger changes.
// ProductUnitBarcode is a full tenant-scoped model: covered by the T1
// tenant-scope Prisma Client Extension, subject to the nested-write ban
// (its own top-level prisma.productUnitBarcode.create(...) call inside
// whatever $transaction it belongs to), and included in T7's cross-tenant
// isolation test suite.
//
// A ProductUnitBarcode row may be hard-deleted (unlike Tenant/Product/
// ProductUnit — see T1's Tenant Lifecycle & Deletion Policy). This is safe
// specifically because InvoiceItem/B2BOrderRequestItem reference unitId,
// never a barcode row — removing a mistaken barcode entry can never orphan
// a financial record. ADMIN-only, mirroring every other inventory-mutation
// action.
//
// SHARED CATALOG (ProductCatalogEntry) — redesigned in parallel: the old
// `barcode String @unique` scalar would have written one near-duplicate
// catalog row per barcode for the same real product (e.g. ten "مدار" rows,
// one per scent). ProductCatalogEntry now holds ONE row per real product,
// linked to a growing list of known barcodes via ProductCatalogEntryBarcode
// (platform-wide unique). Matching any known barcode for a product
// resolves to the same suggested name/category/photo; a merchant entering
// an additional barcode for a product whose other barcode already matched
// an existing entry links the new barcode to that SAME entry instead of
// creating a new one.
//
// [v4.5, review fix] ProductCatalogEntryBarcode.barcode carries `@unique`,
// which already generates its own index at the database level — the
// earlier draft of this model also had a redundant `@@index([barcode])`
// alongside it. Removed: an explicit index over the exact same column an
// implicit unique index already covers wastes storage and slightly slows
// writes for zero read benefit. (VerifiedRetailer.phone above has this same
// redundant pattern from a prior revision, unrelated to this change — left
// untouched here since it's outside this task's scope.)
// ============================================================================

// ============================================================================
// [v4.6] PRODUCT-LEVEL IMAGE — the product image moved from ProductUnit to
// Product. Before this revision every packaging unit (قطعة, طرد, كرتونة)
// carried its own ProductUnit.imageUrl, which forced the merchant to upload
// the same photo once per unit (or leave some units without one) and made
// the storefront's "which unit's image do we show" choice depend on which
// unit happened to have a photo.
//
// THE FIX: ONE image per product — Product.imageUrl. ProductUnit.imageUrl is
// REMOVED with no per-unit override and no unit→product fallback logic
// anywhere. Every screen that shows a product image reads Product.imageUrl.
// The image is uploaded in step 1 of the add-product wizard (معلومات المنتج),
// next to name and category.
//
// Publishing gate (application layer, lib/inventory/publishing-gate.ts):
//   Product.isActive AND Product.imageUrl non-empty
// (a product still needs at least one active unit to be sellable, but no
// unit needs an image). Product.isPublic = true is blocked without it.
//
// This lines up with the shared catalog: ProductCatalogEntry.imageUrl and
// ProductCatalogEntryReport.suggestedImageUrl were already one-image-per-
// real-product, so a catalog suggestion now fills Product.imageUrl directly.
//
// No data migration: all current data is test data. The baseline migration
// is edited in place (add "imageUrl" TEXT to "Product", drop it from
// "ProductUnit") followed by `prisma migrate reset`. Offline (Dexie): the
// product-level imageUrl is a plain non-indexed value field, so no Dexie
// version bump is required, but code reading it offline MUST tolerate
// undefined on devices whose cache predates the next refreshProductCache.
// ============================================================================

enum UserRole {
  ADMIN
  CASHIER
}

enum InvoiceStatus {
  COMPLETED
  PENDING_REVIEW
  VOIDED
}

enum TenantSubscriptionStatus {
  ACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionRecordStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

enum PaymentMethod {
  CASH
  SHAM_CASH
  SYRIATEL_CASH
  BANK_TRANSFER
  OTHER
}

enum PricingCurrency {
  USD
  SYP
}

enum BarcodeSource {
  GS1
  INTERNAL
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum B2BOrderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum CustomerMergeRecordType {
  INVOICE
  PAYMENT
}

model Tenant {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  logo               String?
  phone              String?
  dailyExchangeRate  Decimal?                 @db.Decimal(18, 4)
  subscriptionStatus TenantSubscriptionStatus @default(PENDING)
  expiresAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  users                 User[]
  products              Product[]
  productUnits          ProductUnit[]
  // [v4.5] tenant-scoped, per T1's isolation rules
  productUnitBarcodes   ProductUnitBarcode[]
  productBatches        ProductBatch[]
  customers             Customer[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  customerPayments      CustomerPayment[]
  subscriptions         Subscription[]
  b2bOrderRequests      B2BOrderRequest[]
  customerMergeLogs     CustomerMergeLog[]
  customerMergeLogItems CustomerMergeLogItem[]
  stockAdjustments      StockAdjustment[]
  batchDeletionLogs     BatchDeletionLog[]
  baseUnitChangeLogs    BaseUnitChangeLog[]
  // [v4.2]
  costPriceChangeLogs   CostPriceChangeLog[]

  systemCustomerId     String?               @unique
  systemCustomer       Customer?             @relation("TenantSystemCustomer", fields: [systemCustomerId], references: [id], onDelete: Restrict)
  b2bOrderRequestItems B2BOrderRequestItem[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  email           String   @unique
  passwordHash    String
  role            UserRole
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  reviewedB2BOrderRequests B2BOrderRequest[]
  customerMergeLogs        CustomerMergeLog[]
  stockAdjustments         StockAdjustment[]
  batchDeletionLogs        BatchDeletionLog[]
  baseUnitChangeLogs       BaseUnitChangeLog[]
  // [v4.2]
  costPriceChangeLogs      CostPriceChangeLog[]

  @@index([tenantId])
}

model Product {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  category String?

  // [v4.6] ADDITION — the ONE image for this product (moved here from
  // ProductUnit.imageUrl). Uploaded in step 1 of the add-product wizard,
  // next to name and category. Nullable at the schema level because a
  // product may legitimately exist without a photo (it simply cannot be
  // published): the publishing gate (lib/inventory/publishing-gate.ts)
  // requires `Product.isActive AND imageUrl non-empty` before isPublic may
  // be true. Every screen that displays a product image (storefront card,
  // POS card, inventory table) reads THIS field — there is no per-unit
  // override and no unit→product fallback. Plain value field, not part of
  // any index, so it needs no Dexie version bump (see the [v4.6] note near
  // the top of this file).
  imageUrl String?

  isPublic Boolean @default(false)
  isActive Boolean @default(true)

  // [v4.0] ADDITION — the structural guarantee of "exactly one physical
  // base unit per product." Every ProductBatch.quantity for this product is
  // expressed in this unit and this unit alone. @unique because a
  // ProductUnit can be the base unit of at most one Product (mirrors the
  // Tenant.systemCustomerId pattern used elsewhere in this schema for the
  // exact same "structural, not just conventional, one-to-one" reason).
  //
  // TYPE-LEVEL HONESTY, NOT A LOOPHOLE: this field is String? because
  // Prisma has no way to express "non-null after row creation" — but that
  // does NOT mean application code is free to treat it as usually-present.
  // Product.create() and Product.update({ baseUnitId }) both happen inside
  // ONE $transaction (see lib/inventory/product-create.ts) — a concurrent
  // reader outside that transaction never observes a committed Product row
  // with baseUnitId still null; a crash mid-transaction rolls back the
  // whole thing, leaving no row at all rather than a half-built one (same
  // pattern as T2a's four-write onboarding transaction). The ONLY place
  // permitted to read `.baseUnitId` / `.baseUnit` directly off a Prisma
  // result is lib/inventory/base-unit.ts's requireBaseUnit() — every other
  // call site (POS, inventory screen, sync, B2B approval, CSV import) goes
  // through that function, which returns a non-null ProductUnit or throws
  // MissingBaseUnitError loud and immediately. This mirrors T1's own
  // tenantScopedRawQuery() pattern: the schema stays honest about what CAN
  // happen (a bug), while exactly one guarded chokepoint is what the rest
  // of the codebase is allowed to trust. An ESLint rule (identical
  // mechanism to the $queryRaw and nested-write rules) blocks any direct
  // `.baseUnitId` / `.baseUnit` property access outside that one file; CI
  // fails the build on violation. See UNIT-ARCHITECTURE.md §9 for the
  // full guard code and required tests.
  //
  // [v4.0, corrected] requireBaseUnit() never supplies a conversionFactor
  // for anything other than the base unit itself (always 1). Converting a
  // sold/ordered quantity into base units always uses that sold/ordered
  // unit's OWN conversionFactor, fetched via its own unitId — see
  // InvoiceItem.unitId / B2BOrderRequestItem.unitId below.
  baseUnitId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: a base unit can never be silently detached by a cascading
  // delete — a Product with any batch history depends on this relation to
  // know what physical unit its stock is even counted in. Changing which
  // unit is the base unit after creation is not supported for a product
  // with any ProductBatch (see UNIT-ARCHITECTURE.md, "Why the base unit is
  // immutable"); for a zero-batch product, a correction is possible but
  // must write a BaseUnitChangeLog row (see below).
  baseUnit ProductUnit? @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  units                ProductUnit[]         @relation("ProductUnits")
  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  b2bOrderRequestItems B2BOrderRequestItem[]
  baseUnitChangeLogs   BaseUnitChangeLog[]

  @@index([tenantId])
  @@index([tenantId, isPublic])
}

model ProductUnit {
  id        String @id @default(cuid())
  tenantId  String
  productId String
  unitName  String

  // conversionFactor — [v4.0] one fixed, uniform meaning for every row: "how
  // many base units (Product.baseUnitId) equal ONE of this ProductUnit?" The
  // base unit's own row is forced to conversionFactor = 1 always, and can
  // never be edited after creation as long as the product has any ProductBatch.
  // Any conversion using this field goes exclusively through lib/inventory/units.ts
  // (toBaseUnit/fromBaseUnit/breakdownForDisplay) — no direct quantity *
  // conversionFactor computation is permitted anywhere else, enforced by a
  // dedicated ESLint rule using the same mechanism as the tenant-scope rules.
  //
  // [v4.0, corrected] When converting a sale/order line into base units,
  // ALWAYS use THIS row's own conversionFactor (the unit actually sold in),
  // never the base unit's (which is always 1 and would apply no conversion
  // at all). requireBaseUnit() is not involved in this arithmetic.
  conversionFactor Decimal @db.Decimal(18, 4)

  pricingCurrency PricingCurrency @default(SYP)
  priceWholesale  Decimal         @db.Decimal(18, 4)
  isActive        Boolean         @default(true)

  // [v4.6] REMOVED — `imageUrl String?` used to live here (one image per
  // packaging unit). Replaced by the single Product.imageUrl above: images
  // are a PRODUCT-level concept, with no per-unit override and no fallback
  // logic. A unit has no image of its own anymore.

  // [v4.5] REMOVED — `barcode String?` / `barcodeSource BarcodeSource?` used
  // to live here as scalar fields, one barcode per unit maximum, with
  // `@@unique([tenantId, barcode])` below. Replaced by the `barcodes`
  // relation to ProductUnitBarcode, which allows zero, one, or many
  // barcodes per unit — see the [v4.5] note near the top of this file.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation("ProductUnits", fields: [productId], references: [id], onDelete: Cascade)

  // [v4.0] Reverse side of Product.baseUnitId — lets a ProductUnit row know
  // it is wired up as its product's base unit, if it is. At most one
  // Product can point back here, enforced by @unique on Product.baseUnitId.
  isBaseUnitOf Product? @relation("ProductBaseUnit")

  // [v4.5] zero, one, or many barcodes for this unit — see ProductUnitBarcode
  // below. The tenant-wide uniqueness constraint on barcode value now lives
  // on that model, not here.
  barcodes ProductUnitBarcode[]

  batches              ProductBatch[]
  invoiceItems         InvoiceItem[]
  b2bOrderRequestItems B2BOrderRequestItem[]
  // [v4.0] the two sides of a base-unit correction event — see
  // BaseUnitChangeLog below.
  baseUnitChangesFrom  BaseUnitChangeLog[]   @relation("BaseUnitChangeOld")
  baseUnitChangesTo    BaseUnitChangeLog[]   @relation("BaseUnitChangeNew")

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, isActive])
}

// ============================================================================
// [v4.5] ProductUnitBarcode — one row per physical barcode attached to a
// ProductUnit. Replaces ProductUnit.barcode/barcodeSource. A unit may have
// zero rows (no barcode yet), one row (today's common case, unchanged in
// behavior), or many rows (a merchant grouping several manufacturer
// barcodes — e.g. one per scent/variant — under a single tracked unit).
//
// barcodeSource keeps the exact same meaning and confirmation rule as
// before (T3a §5): null until a human explicitly classifies it as GS1 or
// INTERNAL, no inference from digit pattern ever permitted, enforced by the
// same ESLint mechanism. With multiple barcodes added in one session, the
// UI presents one modal listing every new barcode with its own radio group
// (no pre-selection), plus an optional human-initiated "apply to all"
// action — see the T3a-addendum spec doc for the full UI rule.
//
// Deletion of a single row here is a real, hard DELETE (unlike Tenant/
// Product/ProductUnit's soft-delete-only policy) — safe because
// InvoiceItem/B2BOrderRequestItem key off unitId, never off a barcode row,
// so removing a mistaken barcode can never orphan a financial record.
// ADMIN-only, per T2b's Role Capability Matrix.
// ============================================================================
model ProductUnitBarcode {
  id            String         @id @default(cuid())
  tenantId      String
  unitId        String
  barcode       String
  barcodeSource BarcodeSource?
  createdAt     DateTime       @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade — mirrors T1's general "financially-adjacent rows
  // are never silently swept away by a parent delete" posture. In practice
  // a ProductUnit is soft-deleted (isActive: false), never hard-deleted, so
  // this Restrict is never actually exercised, but it keeps the same
  // explicit-over-implicit stance as the rest of this schema.
  unit   ProductUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, barcode])
  @@index([tenantId, unitId])
}

model ProductBatch {
  id        String @id @default(cuid())
  tenantId  String
  productId String

  // [v4.0] REDEFINED — no longer "whichever unit the merchant was entering
  // stock in." This now ALWAYS equals Product.baseUnitId for the same
  // productId, enforced at the application layer on every write path
  // (batch creation, CSV import, seed script) — never accepted as a free
  // choice from the client. Every write path resolves this value via
  // requireBaseUnit(tx, tenantId, productId) (lib/inventory/base-unit.ts) —
  // never a client-supplied unitId, and never a direct baseUnitId field
  // read (see the guard note on Product.baseUnitId above). The relation
  // itself still points at ProductUnit (not duplicated as a denormalized
  // flag) so existing joins (FIFO ordering, InvoiceItem.batch.unit
  // displays) keep working unchanged; what changed is the WRITE-TIME
  // GUARANTEE on which unit that relation is allowed to reference.
  unitId      String
  batchNumber String
  // Always expressed in the product's base unit — see the note on
  // Product.baseUnitId above. Never a "طرد" count, never a "كرتونة" count.
  //
  // [v4.4] batchNumber's VALUE follows a standardized, application-enforced
  // format: {server-date}-{required merchant-supplied text}, e.g.
  // "2026-09-27-1" or "2026-09-27-INV4471". The date prefix is generated
  // server-side at the moment of creation (never client-supplied); the
  // merchant part is required free text with no auto-increment/uniqueness
  // suggestion. This is a write-time construction rule enforced identically
  // on every batch-creation path (single-batch entry, the multi-product
  // receipt screen, CSV import) — no schema change, since this field was
  // already a plain String.
  quantity    Decimal   @db.Decimal(18, 4)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())

  // [v4.2] T4g's batch purchase-cost figure. Always SYP, always expressed
  // per unit of the product's base unit (same principle as `quantity`).
  //
  // [v4.4] REQUIRED (non-nullable) — mandatory at creation time on every
  // batch-creation path (single-batch entry, the multi-product receipt
  // screen, CSV import), ADMIN-only, enforced at the API layer. There is no
  // "cost not yet set" state: this platform has no pre-existing data to
  // protect via a nullable/backfill accommodation, so the field is required
  // from day one. Never read directly for a sale's cost calculation without
  // going through the frozen InvoiceItem.costAmountSYP at commit time.
  // Editing this field on an existing batch always writes one
  // CostPriceChangeLog row in the same transaction (see that model below).
  // [Batch cost entry] Decimal(18, 8) — deliberately NOT (18, 4) like every
  // other monetary column in this schema. Unlike a price a human types
  // directly, this figure is DERIVED by division: the merchant enters the
  // TOTAL paid for a received quantity, and lib/inventory/units.ts's
  // costFromTotal() computes total / (quantity x conversionFactor). A
  // non-terminating per-base price (100,000 SYP over 3 pieces) must survive
  // at 8 dp, because it is the value that must reproduce the typed total
  // when multiplied back out; at 4 dp Postgres would silently round it and
  // the stored figure would stop reconciling with what was actually paid.
  costPricePerBaseUnit Decimal @db.Decimal(18, 8)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit         ProductUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  // [v4.3] REMOVED — `adjustments StockAdjustment[]` used to be here. It is
  // deleted because StockAdjustment no longer carries a live @relation back
  // to ProductBatch (see the note on the StockAdjustment model below) — a
  // Prisma relation requires both sides, and keeping a one-sided back-
  // reference is not valid. This brings ProductBatch in line with how it
  // already treats BatchDeletionLog (never listed as a back-relation here
  // either, for the identical "snapshot, not live FK" reason). Look up a
  // batch's adjustment history via `where: { batchId }` against
  // StockAdjustment's plain indexed field instead.
  // [v4.4] REMOVED — @@index([tenantId, costPricePerBaseUnit]) used to be
  // here, backing a "batches with no cost price set" backfill filter/banner.
  // That filter no longer exists: costPricePerBaseUnit can never be null,
  // so there is nothing for such a query to search for.

  @@index([tenantId])
  @@index([productId])
  @@index([unitId])
  @@index([expiryDate])
  @@index([tenantId, quantity])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  shopName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isSystemGenerated      Boolean @default(false)
  tenantAsSystemCustomer Tenant? @relation("TenantSystemCustomer")

  offlineId String? @unique

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments CustomerPayment[]

  mergesAsSurvivor          CustomerMergeLog[] @relation("MergeSurviving")
  mergesAsMerged            CustomerMergeLog[] @relation("MergeMerged")
  matchedByB2BOrderRequests B2BOrderRequest[]

  @@index([tenantId])
  @@index([offlineId])
  @@index([tenantId, phone])
  @@index([tenantId, isSystemGenerated])
}

model VerifiedRetailer {
  id                String   @id @default(cuid())
  phone             String   @unique
  shopName          String?
  firstVerifiedAt   DateTime @default(now())
  verificationCount Int      @default(1)

  @@index([phone])
}

// ============================================================================
// [v4.5] ProductCatalogEntry — REDESIGNED. The old model keyed on a single
// `barcode String @unique` column, writing one row per barcode. With a
// ProductUnit now able to carry many barcodes, that would write one
// near-duplicate catalog row per barcode for the same real product (e.g.
// ten separate "مدار" rows, one per scent, all sharing name/category/photo).
//
// Now: ONE ProductCatalogEntry per real product, linked to a growing list
// of known barcodes via ProductCatalogEntryBarcode. Matching ANY of a
// product's known barcodes resolves to the same suggested name/category/
// photo for the one-time fill-in convenience (T3a §6, unchanged in
// behavior otherwise — still a one-time suggestion, never re-synced). A
// merchant entering an additional GS1 barcode on a unit whose OTHER
// barcode already matched an existing entry links the new barcode to that
// SAME entry (a new ProductCatalogEntryBarcode row) instead of creating a
// second entry.
//
// [v4.6] imageUrl here is one-image-per-real-product, which now matches
// Product.imageUrl directly: a catalog suggestion fills Product.imageUrl
// (previously it had to pick a single unit's image field to fill).
// ============================================================================
model ProductCatalogEntry {
  id              String   @id @default(cuid())
  name            String
  category        String?
  imageUrl        String?
  addedByTenantId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barcodes ProductCatalogEntryBarcode[]
  reports  ProductCatalogEntryReport[]

  @@index([addedByTenantId])
}

// ============================================================================
// [v4.5] ProductCatalogEntryBarcode — platform-wide, one row per barcode
// known for a catalog entry. `barcode` keeps the platform-wide @unique
// constraint the old ProductCatalogEntry.barcode field used to carry — this
// alone already provides the index; no separate @@index([barcode]) is
// added (see the [v4.5, review fix] note near the top of this file).
// Cascade on delete: these rows have no independent meaning without their
// parent entry (unlike ProductUnitBarcode, which is tenant-scoped and
// financially adjacent enough to warrant Restrict — this table is neither).
// ============================================================================
model ProductCatalogEntryBarcode {
  id             String   @id @default(cuid())
  catalogEntryId String
  barcode        String   @unique
  createdAt      DateTime @default(now())

  catalogEntry ProductCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([catalogEntryId])
}

model ProductCatalogEntryReport {
  id                 String       @id @default(cuid())
  catalogEntryId     String
  reportedByTenantId String
  reason             String
  suggestedName      String?
  suggestedCategory  String?
  suggestedImageUrl  String?
  status             ReportStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  resolvedAt         DateTime?

  catalogEntry ProductCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([catalogEntryId])
  @@index([status])
}

model Invoice {
  id               String        @id @default(cuid())
  tenantId         String
  userId           String
  customerId       String
  totalSYP         Decimal       @db.Decimal(18, 4)
  totalUSD         Decimal       @db.Decimal(18, 4)
  exchangeRateUsed Decimal       @db.Decimal(18, 4)
  paidAmountSYP    Decimal       @db.Decimal(18, 4)
  paidAmountUSD    Decimal       @db.Decimal(18, 4)
  debtAmountSYP    Decimal       @db.Decimal(18, 4)
  debtAmountUSD    Decimal       @db.Decimal(18, 4)
  isPaid           Boolean       @default(false)
  status           InvoiceStatus @default(COMPLETED)
  isSynced         Boolean       @default(true)
  offlineId        String?       @unique
  syncedAt         DateTime?
  receiptPdfUrl    String?
  createdAt        DateTime      @default(now())

  voidsInvoiceId String?  @unique
  voidsInvoice   Invoice? @relation("InvoiceVoid", fields: [voidsInvoiceId], references: [id], onDelete: Restrict)
  voidedBy       Invoice? @relation("InvoiceVoid")

  voidReason String?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  payment CustomerPayment?

  b2bOrderRequest B2BOrderRequest?

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String
  productId String

  // [v4.0] NOTE — this still records the ProductUnit that was actually SOLD
  // (e.g. "طرد"), NOT necessarily the product's base unit. This is
  // deliberate and unchanged: a customer buys and is billed in whichever
  // unit they chose at the register. What changed is only how `quantity`
  // here relates to ProductBatch.quantity: the sale-time conversion from
  // "N of this sold unit" into "N × conversionFactor of the batch's base
  // unit" happens exactly once, through lib/inventory/units.ts, at the
  // moment stock is drawn down (T4c/T5's commitFifoAllocation call) — see
  // UNIT-ARCHITECTURE.md, "Selling in a non-base unit."
  //
  // [v4.0, corrected] The conversionFactor used for that conversion is
  // ALWAYS read from THIS unit row (via this unitId) — never from
  // requireBaseUnit(), which resolves an unrelated base-unit row whose
  // conversionFactor is always 1.
  //
  // [v4.5] NOTE — which specific barcode the cashier scanned to arrive at
  // this unitId is never recorded here. If a unit has several barcodes
  // (e.g. multiple مدار scents grouped under one unit), the invoice line
  // reflects the unit sold, not which barcode variant was scanned — this is
  // an accepted limitation, not a bug (see the T3a-addendum spec doc's
  // "حدود بالمنتج نفسو" section).
  unitId String

  batchId      String
  // Quantity SOLD, expressed in `unitId` above (the unit the customer
  // actually bought) — e.g. "3" meaning 3 طرد. NOT automatically the same
  // number as how much was deducted from ProductBatch.quantity, which is
  // always in the batch's base unit. The relationship between the two is
  // always: batchQuantityDeducted = quantity × unitId.conversionFactor,
  // computed once via decimal.js at commit time and never re-derived
  // afterward from anything other than this stored quantity + unit.
  quantity     Decimal @db.Decimal(18, 4)
  unitPriceSYP Decimal @db.Decimal(18, 4)
  unitPriceUSD Decimal @db.Decimal(18, 4)

  // [v4.2] T4g's frozen cost basis for this line, computed once at commit
  // time (T4c sync or T5 B2B approval):
  //   costAmountSYP = toBaseUnit(quantity, soldUnit.conversionFactor)
  //                   × batch.costPricePerBaseUnit
  // Once written, this value is frozen forever — a later edit to the
  // batch's cost price never touches an already-written InvoiceItem,
  // mirroring how exchangeRateUsed is frozen at sale time.
  //
  // [v4.4] REQUIRED (non-nullable) — since ProductBatch.costPricePerBaseUnit
  // can never be null, this is always computable at commit time. Profit
  // (unitPriceSYP × quantity − costAmountSYP) is always fully derivable on
  // read (T4c2, T4h) with no null-exclusion branch anywhere.
  //
  // A VOIDED invoice's line carries the negated value (via
  // subtractMoney("0", …), never a raw Decimal negation) — see T4d/T4g.
  costAmountSYP Decimal @db.Decimal(18, 4)

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    ProductUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  batch   ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([batchId])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  amountSYP     Decimal       @db.Decimal(18, 4)
  amountUSD     Decimal       @db.Decimal(18, 4)
  exchangeRate  Decimal       @db.Decimal(18, 4)
  paymentMethod PaymentMethod
  receiptNo     String?
  notes         String?
  isSynced      Boolean       @default(true)
  offlineId     String?       @unique
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())

  invoiceId String? @unique

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([offlineId])
}

model Subscription {
  id              String                   @id @default(cuid())
  tenantId        String
  tier            String
  receiptImageURL String?
  amountUSD       Decimal                  @db.Decimal(18, 4)
  referenceCode   String                   @unique
  status          SubscriptionRecordStatus @default(PENDING_APPROVAL)
  expiresAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status])
}

model B2BOrderRequest {
  id               String         @id @default(cuid())
  tenantId         String
  retailerName     String
  retailerPhone    String
  retailerShopName String?
  status           B2BOrderStatus @default(PENDING_REVIEW)
  rejectionReason  String?

  matchedCustomerId String?
  matchedCustomer   Customer? @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)

  resultingInvoiceId String?  @unique
  resultingInvoice   Invoice? @relation(fields: [resultingInvoiceId], references: [id], onDelete: Restrict)

  reviewedByUserId String?
  reviewedByUser   User?     @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  B2BOrderRequestItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, retailerPhone, status])
}

model B2BOrderRequestItem {
  id             String  @id @default(cuid())
  tenantId       String
  orderRequestId String
  productId      String
  // [v4.0] NOTE — same meaning as InvoiceItem.unitId: the unit the retailer
  // actually selected to order in, not necessarily the base unit. The
  // snapshot below freezes price only; the quantity→base-unit conversion
  // still happens once, at approval time, via lib/inventory/units.ts.
  //
  // [v4.0, corrected] The conversionFactor used for that conversion is
  // ALWAYS read from THIS unit row (via this unitId) — never from
  // requireBaseUnit(), and never from priceWholesaleSnapshot /
  // pricingCurrencySnapshot below, which cover pricing only.
  unitId         String
  quantity       Decimal @db.Decimal(18, 4)

  priceWholesaleSnapshot  Decimal         @db.Decimal(18, 4)
  pricingCurrencySnapshot PricingCurrency

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderRequest B2BOrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit         ProductUnit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderRequestId])
}

model CustomerMergeLog {
  id                  String   @id @default(cuid())
  tenantId            String
  survivingCustomerId String
  mergedCustomerId    String   @unique
  performedByUserId   String
  createdAt           DateTime @default(now())

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  survivingCustomer Customer               @relation("MergeSurviving", fields: [survivingCustomerId], references: [id], onDelete: Restrict)
  mergedCustomer    Customer               @relation("MergeMerged", fields: [mergedCustomerId], references: [id], onDelete: Restrict)
  performedByUser   User                   @relation(fields: [performedByUserId], references: [id], onDelete: Restrict)
  items             CustomerMergeLogItem[]

  @@index([tenantId])
  @@index([survivingCustomerId])
}

model CustomerMergeLogItem {
  id         String                  @id @default(cuid())
  tenantId   String
  mergeLogId String
  recordType CustomerMergeRecordType
  // [v4.2] recordId is a plain String, not a live FK — it can point at either
  // an Invoice.id or a CustomerPayment.id depending on recordType, and Prisma
  // has no polymorphic-FK construct to express that. Consistent with
  // BatchDeletionLog.batchId's own "snapshot, not a live relation" pattern.
  recordId   String
  createdAt  DateTime                @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mergeLog CustomerMergeLog @relation(fields: [mergeLogId], references: [id], onDelete: Restrict)

  @@unique([mergeLogId, recordType, recordId])
  @@index([tenantId])
  @@index([mergeLogId])
  @@index([recordId])
}

// ============================================================================
// [v4.3] StockAdjustment.batchId is a plain, indexed snapshot field, NOT a
// live @relation to ProductBatch. Previously (v3.9–v4.2), this was
// `batch ProductBatch @relation(fields: [batchId], references: [id],
// onDelete: Restrict)`. That silently blocked T3c's own stated hard-delete
// eligibility rule ("zero InvoiceItem references") with an undocumented,
// stricter one ("...and zero StockAdjustment references too") — a batch
// that had ever received even one routine reconciliation, regardless of
// sales history, became permanently undeletable. This is the same class of
// conflict CostPriceChangeLog (see below) was deliberately designed from
// the start to avoid, and that BatchDeletionLog.batchId already solved
// correctly since it was introduced.
//
// Three snapshot fields (productId, unitId, batchNumber) accompany batchId
// so this log stays meaningful even after the batch it describes is later
// hard-deleted — mirroring BatchDeletionLog's existing snapshot rationale.
// ProductBatch carries no back-relation field for this model (a Prisma
// relation requires both sides; this one is deliberately one-sided by
// design).
//
// [v4.4] No migration is required for this fix — the platform has no
// pre-existing data. This model is simply the correct schema from day one.
//
// [v4.3, rev.4] @@index([tenantId, batchId]) added alongside the existing
// single-column indexes — see the schema-level performance note near the
// top of this file.
// ============================================================================
model StockAdjustment {
  id       String @id @default(cuid())
  tenantId String

  // Plain snapshot field — deliberately NOT a live @relation. See the
  // model-level note above for the full rationale.
  batchId     String
  // Snapshot fields captured at the moment this row is written, so the
  // adjustment stays meaningful even if the batch is later hard-deleted
  // (possible regardless of adjustment history, per this same fix).
  productId   String
  unitId      String
  batchNumber String

  adjustedByUserId String
  // [v4.0] NOTE — always in the batch's base unit, same as
  // ProductBatch.quantity itself. A reconciliation screen that lets an
  // ADMIN type the correction in a non-base unit (e.g. "طرد ناقص واحد")
  // must convert it to the base unit via lib/inventory/units.ts BEFORE
  // writing this row — quantityDelta itself is never stored in any unit
  // other than the base unit.
  quantityDelta    Decimal  @db.Decimal(18, 4)
  reason           String
  createdAt        DateTime @default(now())

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustedByUser User   @relation(fields: [adjustedByUserId], references: [id], onDelete: Restrict)
  // NOTE: no `batch` relation field here. Look up a batch's adjustment
  // history via `where: { tenantId, batchId }` against the plain indexed
  // fields below — exactly like BatchDeletionLog already does.

  @@index([tenantId])
  @@index([batchId])
  // [v4.3, rev.4] composite — the real query shape used everywhere this
  // log is read (T3c's adjustment-history panel).
  @@index([tenantId, batchId])
}

model BatchDeletionLog {
  id       String @id @default(cuid())
  tenantId String

  batchId             String
  productId           String
  unitId              String
  batchNumber         String
  // [v4.0] NOTE — snapshot is in the base unit, consistent with the batch's
  // own quantity field at the moment it existed.
  quantityAtDeletion  Decimal  @db.Decimal(18, 4)
  // [v4.2] Snapshot of the batch's cost price at the moment of deletion.
  // Keeps this log's existing promise ("prove what was lost, not just that
  // a deletion happened") consistent now that a batch carries a cost figure
  // too.
  //
  // [v4.4] REQUIRED (non-nullable) — every batch always has a real cost
  // price by the time it could be deleted, since costPricePerBaseUnit can
  // never be null.
  costPriceAtDeletion Decimal  @db.Decimal(18, 8)
  deletedByUserId     String
  reason              String
  createdAt           DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedByUser User   @relation(fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([batchId])
}

// ============================================================================
// [v4.0] BaseUnitChangeLog — append-only audit trail for the rare,
// zero-batch-only correction of a product's designated base unit (see
// UNIT-ARCHITECTURE.md's Immutability rule). Same pattern as
// StockAdjustment/BatchDeletionLog: append-only, no updatedAt, every
// relation Restrict. ADMIN-only per T2b's Role Capability Matrix.
//
// This model exists specifically to back the audit-logging promise made in
// the spec's Unit Conversion Architecture section — a base-unit correction
// on a zero-batch product is never a silent field edit.
//
// NOTE: this model's FK relations (product, oldBaseUnit, newBaseUnit) are
// safe to keep live/Restrict because it only ever applies to a zero-batch
// product's ProductUnit rows, not to ProductBatch — there is no equivalent
// hard-delete-eligibility conflict here the way there was for
// StockAdjustment/CostPriceChangeLog and ProductBatch.
// ============================================================================
model BaseUnitChangeLog {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  oldBaseUnitId   String
  newBaseUnitId   String
  changedByUserId String
  reason          String
  createdAt       DateTime @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  oldBaseUnit   ProductUnit @relation("BaseUnitChangeOld", fields: [oldBaseUnitId], references: [id], onDelete: Restrict)
  newBaseUnit   ProductUnit @relation("BaseUnitChangeNew", fields: [newBaseUnitId], references: [id], onDelete: Restrict)
  changedByUser User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([productId])
}

// ============================================================================
// [v4.2] CostPriceChangeLog — append-only audit trail for correcting an
// EXISTING batch's costPricePerBaseUnit (T4g). Closes the one place a
// sensitive financial edit had no audit trail, consistent with
// StockAdjustment / BatchDeletionLog / CustomerMergeLog / BaseUnitChangeLog.
// ADMIN-only per T2b's Role Capability Matrix.
//
// batchId is DELIBERATELY a plain snapshot field, not a live @relation —
// designed correctly from the start, following BatchDeletionLog's
// precedent, rather than repeating the mistake later fixed on
// StockAdjustment in v4.3 (see that model's note above for the full
// rationale: a live Restrict relation here would create the identical
// conflict with T3c's zero-InvoiceItem hard-delete rule).
//
// [v4.4] oldCostPrice and newCostPrice are both REQUIRED (non-nullable) —
// since ProductBatch.costPricePerBaseUnit is mandatory from creation, every
// correction always has a real prior value to record. There is no
// first-time-backfill case.
//
// [v4.3, rev.4] @@index([tenantId, batchId]) added alongside the existing
// single-column indexes — see the schema-level performance note near the
// top of this file.
// ============================================================================
model CostPriceChangeLog {
  id              String   @id @default(cuid())
  tenantId        String
  batchId         String // plain snapshot field, deliberately NOT a live @relation
  oldCostPrice    Decimal  @db.Decimal(18, 8)
  newCostPrice    Decimal  @db.Decimal(18, 8)
  changedByUserId String
  reason          String
  createdAt       DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changedByUser User   @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([batchId])
  // [v4.3, rev.4] composite — the real query shape any future cost-change
  // history panel would use.
  @@index([tenantId, batchId])
}
