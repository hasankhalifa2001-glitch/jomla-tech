NEXT_PUBLIC_APP_URL="http://localhost:3000"

# # S3 / Cloudflare R2
# S3_UPLOAD_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"
# S3_BUCKET_NAME="jomla-receipts"

# ============================================================================
# Cloud Storage — Supabase Storage (replaces S3 / Cloudflare R2)
# No bank card required for the free tier. Setup:
#   1. Create a free project at https://supabase.com (email only).
#   2. Project Settings -> API -> copy "Project URL" and the "service_role"
#      secret key (NOT the anon/public key — the upload handler runs
#      server-side and needs full write access).
#   3. Storage -> New bucket -> name it to match SUPABASE_BUCKET_NAME below
#      -> mark it Public (so getPublicUrl() returns a browser-servable URL).
# Free tier: 1GB storage / 2GB egress per month.
# ============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET_NAME=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
